        <script>
          // Live prefix update
          const prefixInput = document.getElementById('receipt_prefix');
          const prefixPreview = document.getElementById('prefix-preview');
          if (prefixInput && prefixPreview) {
            prefixInput.addEventListener('input', (e) => {
              const val = e.target.value.trim().toUpperCase() || 'REC';
              prefixPreview.textContent = `${val}-000043`;
            });
          }

          // Tab interaction
          document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              document.querySelectorAll('.tab-btn').forEach(b => {
                b.className = 'tab-btn flex items-center gap-xs px-md sm:px-lg py-sm rounded-lg font-body-md text-body-md text-[13px] sm:text-[14px] text-on-surface-variant hover:text-on-surface transition-all shrink-0';
              });
              btn.className = 'tab-btn active-tab flex items-center gap-xs px-md sm:px-lg py-sm rounded-lg font-title-md text-title-md text-[13px] sm:text-[14px] font-medium bg-surface-container-lowest text-on-surface shadow-sm transition-all shrink-0';
            });
          });

          // Template selection interaction
          document.querySelectorAll('.template-card').forEach(card => {
            card.addEventListener('click', () => {
              document.querySelectorAll('.template-card').forEach(c => {
                c.classList.remove('ring-2', 'ring-primary-container', 'shadow-md', 'opacity-100');
                c.classList.add('opacity-80');
                const badge = c.querySelector('span.font-bold');
                if (badge) badge.className = 'font-label-md text-[10px] text-on-surface-variant';
              });
              card.classList.remove('opacity-80');
              card.classList.add('ring-2', 'ring-primary-container', 'shadow-md', 'opacity-100');
            });
          });

          // Live template preview sync
          const waTemplate = document.getElementById('wa_template');
          const waPreview = document.getElementById('wa-preview-text');
          if (waTemplate && waPreview) {
            waTemplate.addEventListener('input', (e) => {
              let text = e.target.value;
              text = text.replace('{customer_name}', '<strong>Amara Okafor</strong>')
                         .replace('{receipt_number}', '<strong>REC-000043</strong>')
                         .replace('{amount}', '<strong>₦45,000.00</strong>')
                         .replace('{receipt_link}', '<u>ptrail.co/r/43a9</u>');
              waPreview.innerHTML = text;
            });
          }

          function insertVar(val) {
            if (!waTemplate) return;
            waTemplate.value += ` ${val}`;
            waTemplate.dispatchEvent(new Event('input'));
          }

          // Save Feedback Simulation
          const saveBtn = document.getElementById('save-btn');
          const autoSaveInd = document.getElementById('autosave-indicator');
          if (saveBtn) {
            saveBtn.addEventListener('click', () => {
              saveBtn.disabled = true;
              saveBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">refresh</span><span>Saving...</span>';
              setTimeout(() => {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">check</span><span>Saved</span>';
                if (autoSaveInd) autoSaveInd.textContent = 'Saved just now';
                setTimeout(() => {
                  saveBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">save</span><span>Save Changes</span>';
                }, 2000);
              }, 600);
            });
          }

          const discardBtn = document.getElementById('discard-btn');
          if (discardBtn) {
            discardBtn.addEventListener('click', () => {
              document.getElementById('settings-form').reset();
              if (prefixPreview) prefixPreview.textContent = 'REC-000043';
            });
          }
        </script>
      </div>
    </main>
  </div>
</body>
