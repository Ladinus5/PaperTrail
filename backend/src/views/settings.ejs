  <main class="w-full pt-16 bg-surface px-md sm:px-lg py-md sm:py-xl min-h-screen pb-40">
  <div class="flex flex-col w-full">
    <div class="max-w-6xl w-full mx-auto flex flex-col gap-lg sm:gap-xl pb-24">

      <!-- Header -->
      <div class="flex flex-col md:flex-row md:items-end justify-between gap-md pb-xs sm:pb-md">
        <div class="flex flex-col gap-xs">
          <div class="flex items-center gap-sm">
            <span class="font-label-md text-label-md uppercase tracking-wider text-primary font-semibold">Workspace Settings</span>
            <span class="w-1 h-1 rounded-full bg-outline-variant"></span>
            <span class="font-code-md text-code-md text-on-surface-variant"></span>
          </div>
          <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight text-[24px] sm:text-[32px]">Settings</h1>
          <p class="font-body-md text-body-md text-on-surface-variant text-[13px] sm:text-[14px]">Manage your business profile, receipt defaults, and preferences.</p>
        </div>
        <div class="flex items-center gap-sm self-start md:self-auto bg-surface-container-low px-md py-xs rounded-full">
          <span class="w-2 h-2 rounded-full bg-primary-container" id="autosave-dot"></span>
          <span class="font-label-md text-label-md text-on-surface-variant" id="autosave-indicator">Ready</span>
        </div>
      </div>

      <!-- Tabs -->
      <div class="bg-surface-container p-xs rounded-xl flex items-center gap-xs overflow-x-auto whitespace-nowrap">
        <button type="button" class="tab-btn active-tab flex items-center gap-xs px-md sm:px-lg py-sm rounded-lg font-title-md text-[13px] sm:text-[14px] font-medium bg-surface-container-lowest text-on-surface shadow-sm transition-all shrink-0" data-tab="profile">
          <span class="material-symbols-outlined text-[18px] text-primary">storefront</span>
          <span>Business Profile</span>
        </button>
        <button type="button" class="tab-btn flex items-center gap-xs px-md sm:px-lg py-sm rounded-lg font-body-md text-[13px] sm:text-[14px] text-on-surface-variant hover:text-on-surface transition-all shrink-0" data-tab="receipts">
          <span class="material-symbols-outlined text-[18px]">receipt_long</span>
          <span>Receipt Preferences</span>
        </button>
        <button type="button" class="tab-btn flex items-center gap-xs px-md sm:px-lg py-sm rounded-lg font-body-md text-[13px] sm:text-[14px] text-on-surface-variant hover:text-on-surface transition-all shrink-0" data-tab="coming-soon">
          <span class="material-symbols-outlined text-[18px]">chat</span>
          <span>WhatsApp &amp; Delivery</span>
          <span class="px-1.5 py-0.5 rounded text-[10px] bg-secondary-container text-on-secondary-container font-semibold">Soon</span>
        </button>
      </div>

      <form class="flex flex-col gap-xl" id="settings-form">

        <div id="settings-error" class="hidden p-md rounded-xl bg-error-container text-on-error-container font-body-md"></div>

        <!-- SECTION 1: Business Profile -->
        <section class="flex flex-col gap-md sm:gap-lg" id="section-business">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div class="flex flex-col">
              <span class="font-label-md text-label-md text-primary font-semibold uppercase tracking-wider">01. Identity &amp; Legal</span>
              <h2 class="font-headline-md text-on-surface text-[20px] sm:text-[24px]">Business Information</h2>
            </div>
            <span class="font-label-md text-label-md px-sm py-xs rounded-lg bg-surface-container-high text-on-surface-variant font-medium self-start sm:self-auto">Public in Receipts</span>
          </div>

          <div class="bg-surface-container-lowest p-md sm:p-lg rounded-xl shadow-sm flex flex-col gap-md">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
              <div class="flex flex-col gap-xs md:col-span-2">
                <label class="font-label-md text-label-md text-on-surface-variant" for="biz_name">Registered Business Name</label>
                <input id="biz_name" name="name" type="text"
                  class="h-10 px-md rounded-lg bg-surface-container-low font-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest transition-all"
                  value="<%= company.name || '' %>"/>
              </div>

              <div class="flex flex-col gap-xs">
                <label class="font-label-md text-label-md text-on-surface-variant" for="biz_email">Official Billing Email</label>
                <input id="biz_email" name="email" type="email"
                  class="h-10 px-md rounded-lg bg-surface-container-low font-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest transition-all"
                  value="<%= company.email || '' %>"/>
              </div>

              <div class="flex flex-col gap-xs">
                <label class="font-label-md text-label-md text-on-surface-variant" for="biz_phone">Customer Support Phone</label>
                <input id="biz_phone" name="phone" type="tel"
                  class="h-10 px-md rounded-lg bg-surface-container-low font-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest transition-all"
                  value="<%= company.phone || '' %>"/>
              </div>

              <div class="flex flex-col gap-xs md:col-span-2">
                <label class="font-label-md text-label-md text-on-surface-variant" for="biz_addr">Physical Store / Headquarters Address</label>
                <input id="biz_addr" name="address" type="text"
                  class="h-10 px-md rounded-lg bg-surface-container-low font-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest transition-all"
                  value="<%= company.address || '' %>"/>
              </div>

              <div class="flex flex-col gap-xs">
                <label class="font-label-md text-label-md text-on-surface-variant" for="biz_web">Website or Social Handle</label>
                <input id="biz_web" name="website" type="text"
                  class="h-10 px-md rounded-lg bg-surface-container-low font-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest transition-all"
                  value="<%= company.website || '' %>"/>
              </div>

              <div class="flex flex-col gap-xs">
                <label class="font-label-md text-label-md text-on-surface-variant" for="biz_tin">Tax ID (TIN) / RC Number</label>
                <input id="biz_tin" name="tin" type="text"
                  class="h-10 px-md rounded-lg bg-surface-container-low font-code-md text-on-surface focus:outline-none focus:bg-surface-container-lowest transition-all uppercase"
                  value="<%= company.tin || '' %>"/>
              </div>

              <div class="flex flex-col gap-xs md:col-span-2">
                <label class="font-label-md text-label-md text-on-surface-variant" for="biz_logo">Logo URL (PNG/SVG)</label>
                <input id="biz_logo" name="logoUrl" type="text"
                  class="h-10 px-md rounded-lg bg-surface-container-low font-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest transition-all"
                  placeholder="https://..."
                  value="<%= company.logoUrl || '' %>"/>
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 2: Receipt Configuration -->
        <section class="flex flex-col gap-md sm:gap-lg" id="section-receipts">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
            <div class="flex flex-col">
              <span class="font-label-md text-label-md text-primary font-semibold uppercase tracking-wider">02. Formatting &amp; Ledger</span>
              <h2 class="font-headline-md text-on-surface text-[20px] sm:text-[24px]">Receipt Configuration</h2>
            </div>
          </div>

          <div class="bg-surface-container-lowest p-md sm:p-lg rounded-xl shadow-sm flex flex-col gap-md">
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
              <div class="flex flex-col gap-xs">
                <label class="font-label-md text-label-md text-on-surface-variant" for="currency_select">Primary Currency</label>
                <select id="currency_select" name="currency"
                  class="h-10 px-md rounded-lg bg-surface-container-low font-body-md text-on-surface appearance-none focus:outline-none focus:bg-surface-container-lowest transition-all">
                  <option value="NGN" <%= company.currency === 'NGN' ? 'selected' : '' %>>NGN (₦) - Nigerian Naira</option>
                  <option value="USD" <%= company.currency === 'USD' ? 'selected' : '' %>>USD ($) - United States Dollar</option>
                  <option value="GBP" <%= company.currency === 'GBP' ? 'selected' : '' %>>GBP (£) - British Pound</option>
                  <option value="GHS" <%= company.currency === 'GHS' ? 'selected' : '' %>>GHS (₵) - Ghanaian Cedi</option>
                </select>
              </div>

              <div class="flex flex-col gap-xs">
                <label class="font-label-md text-label-md text-on-surface-variant" for="receipt_prefix">Receipt Prefix Code</label>
                <input id="receipt_prefix" name="receiptPrefix" type="text"
                  class="h-10 px-md rounded-lg bg-surface-container-low font-code-md text-on-surface uppercase tracking-wider focus:outline-none focus:bg-surface-container-lowest transition-all"
                  value="<%= company.receiptPrefix || 'REC' %>"/>
              </div>
            </div>
          </div>
        </section>

        <!-- SECTION 3: Coming Soon -->
        <section class="flex flex-col gap-md sm:gap-lg">
          <div class="flex flex-col">
            <span class="font-label-md text-label-md text-primary font-semibold uppercase tracking-wider">03. Messaging &amp; Automated Pipeline</span>
            <h2 class="font-headline-md text-on-surface text-[20px] sm:text-[24px]">WhatsApp &amp; Delivery</h2>
          </div>

          <div class="bg-surface-container-lowest p-md sm:p-xl rounded-xl shadow-sm flex flex-col md:flex-row items-start md:items-center gap-lg relative overflow-hidden">
            <div class="w-14 h-14 rounded-2xl bg-secondary-container flex items-center justify-center text-primary flex-shrink-0 shadow-sm">
              <span class="material-symbols-outlined text-[28px]">chat</span>
            </div>
            <div class="flex flex-col gap-xs flex-1">
              <div class="flex items-center gap-xs">
                <h3 class="font-headline-md text-on-surface font-bold text-[18px]">Automated WhatsApp Delivery</h3>
                <span class="px-2 py-0.5 rounded-full bg-secondary-container text-on-secondary-container text-[11px] font-semibold">Coming Soon</span>
              </div>
              <p class="font-body-md text-on-surface-variant text-[13px]">
                Send receipt PDFs directly to customers via WhatsApp the moment a sale is made. No clicks, no links needed. Currently in development.
              </p>
            </div>
          </div>
        </section>

        <!-- Save Bar -->
        <div class="sticky bottom-4 z-30 bg-surface-container-lowest/95 backdrop-blur-md p-sm sm:p-md rounded-2xl shadow-xl flex items-center justify-between mt-lg border border-outline-variant/30 gap-xs">
          <div class="flex items-center gap-sm sm:gap-md">
            <div class="w-8 h-8 rounded-full bg-surface-container-high flex items-center justify-center text-on-surface-variant shrink-0">
              <span class="material-symbols-outlined text-[18px]">save</span>
            </div>
            <div class="flex flex-col">
              <span class="font-title-md text-[12px] sm:text-[13px] text-on-surface font-medium leading-tight" id="save-status-text">Changes not saved</span>
              <span class="font-label-md text-label-md text-on-surface-variant hidden sm:inline">Applies to new receipts</span>
            </div>
          </div>
          <div class="flex items-center gap-xs sm:gap-sm">
            <button id="discard-btn" type="reset"
              class="px-md sm:px-lg py-sm rounded-xl font-title-md text-[13px] sm:text-[14px] text-on-surface-variant hover:bg-surface-container-high transition-colors">
              Discard
            </button>
            <button id="save-btn" type="submit"
              class="inline-flex items-center gap-xs px-md sm:px-xl py-sm rounded-xl bg-primary-container hover:bg-primary text-on-primary font-title-md text-[13px] sm:text-[14px] font-medium shadow-md transition-all active:scale-[0.98]">
              <span class="material-symbols-outlined text-[18px]">save</span>
              <span id="save-btn-text">Save Changes</span>
            </button>
          </div>
        </div>
      </form>

    </div>
  </div>
</main>

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Tabs
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.className = 'tab-btn flex items-center gap-xs px-md sm:px-lg py-sm rounded-lg font-body-md text-[13px] sm:text-[14px] text-on-surface-variant hover:text-on-surface transition-all shrink-0';
      });
      btn.className = 'tab-btn active-tab flex items-center gap-xs px-md sm:px-lg py-sm rounded-lg font-title-md text-[13px] sm:text-[14px] font-medium bg-surface-container-lowest text-on-surface shadow-sm transition-all shrink-0';
    });
  });

  const form = document.getElementById('settings-form');
  const saveBtn = document.getElementById('save-btn');
  const saveBtnText = document.getElementById('save-btn-text');
  const statusText = document.getElementById('save-status-text');
  const indicator = document.getElementById('autosave-indicator');
  const errorBox = document.getElementById('settings-error');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    errorBox.classList.add('hidden');
    saveBtn.disabled = true;
    saveBtnText.textContent = 'Saving...';
    indicator.textContent = 'Saving...';

    const payload = {
      name:          form.name.value.trim(),
      email:         form.email.value.trim() || null,
      phone:         form.phone.value.trim() || null,
      address:       form.address.value.trim() || null,
      website:       form.website.value.trim() || null,
      tin:           form.tin.value.trim() || null,
      logoUrl:       form.logoUrl.value.trim() || null,
      currency:      form.currency.value,
      receiptPrefix: form.receiptPrefix.value.trim().toUpperCase() || 'REC',
    };

    try {
      const res = await fetch('/api/company', {
        method: 'PATCH',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(payload),
      });
      const raw = await res.text();
      let data;
      try { data = JSON.parse(raw); } catch { throw new Error('Server error.'); }
      if (!res.ok || !data.success) throw new Error(data.message || 'Save failed');

      saveBtnText.textContent = 'Saved!';
      statusText.textContent = 'Saved just now';
      indicator.textContent = 'Saved just now';
      setTimeout(() => {
        saveBtn.disabled = false;
        saveBtnText.textContent = 'Save Changes';
      }, 1500);
    } catch (err) {
      errorBox.textContent = err.message;
      errorBox.classList.remove('hidden');
      saveBtn.disabled = false;
      saveBtnText.textContent = 'Save Changes';
      indicator.textContent = 'Save failed';
    }
  });
});
</script>