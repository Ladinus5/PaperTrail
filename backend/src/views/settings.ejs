<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Courier+Prime&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
  <style>
    @layer base {
      html, body { margin: 0; padding: 0; }
      body { overscroll-behavior: none; }
      main > :first-child { margin-top: 0 !important; }
      main > :last-child { margin-bottom: 0 !important; }
    }
    ::-webkit-scrollbar { display: none; }
  </style>
  <script src="https://cdn.tailwindcss.com"></script>
  <script id="tailwind-config">
    tailwind.config = {
      "darkMode": "class",
      "theme": {
        "extend": {
          "colors": {
            "surface-variant": "#e2e2eb",
            "secondary-container": "#dce2f3",
            "on-primary-fixed-variant": "#00429b",
            "surface-bright": "#faf8ff",
            "on-tertiary-fixed-variant": "#7f2b00",
            "tertiary-fixed-dim": "#ffb599",
            "on-primary": "#ffffff",
            "on-background": "#191b22",
            "outline-variant": "#c3c6d5",
            "surface-container-lowest": "#ffffff",
            "primary-fixed": "#d9e2ff",
            "secondary-fixed-dim": "#c0c7d6",
            "tertiary": "#682200",
            "tertiary-fixed": "#ffdbce",
            "on-error-container": "#93000a",
            "on-tertiary": "#ffffff",
            "background": "#faf8ff",
            "on-tertiary-container": "#ffaf90",
            "on-primary-fixed": "#001945",
            "tertiary-container": "#8e3100",
            "on-primary-container": "#a9c1ff",
            "inverse-surface": "#2e3037",
            "on-secondary": "#ffffff",
            "surface-container-highest": "#e2e2eb",
            "on-surface": "#191b22",
            "inverse-on-surface": "#f0f0f9",
            "on-secondary-fixed": "#151c27",
            "surface-tint": "#215abd",
            "error-container": "#ffdad6",
            "surface": "#faf8ff",
            "secondary-fixed": "#dce2f3",
            "surface-container": "#ededf6",
            "surface-container-high": "#e7e7f0",
            "inverse-primary": "#b0c6ff",
            "on-tertiary-fixed": "#370e00",
            "primary-container": "#004aad",
            "primary-fixed-dim": "#b0c6ff",
            "on-secondary-fixed-variant": "#404754",
            "surface-dim": "#d9d9e2",
            "secondary": "#585f6c",
            "outline": "#737784",
            "on-secondary-container": "#5e6572",
            "on-error": "#ffffff",
            "surface-container-low": "#f3f3fc",
            "primary": "#00357f",
            "on-surface-variant": "#434653",
            "error": "#ba1a1a"
          },
          "borderRadius": {
            "DEFAULT": "0.125rem",
            "lg": "0.25rem",
            "xl": "0.5rem",
            "full": "0.75rem"
          },
          "spacing": {
            "margin-desktop": "40px",
            "lg": "24px",
            "gutter": "24px",
            "2xl": "48px",
            "xl": "32px",
            "md": "16px",
            "margin-mobile": "16px",
            "sm": "8px",
            "xs": "4px",
            "base": "4px"
          },
          "fontFamily": {
            "headline-lg": ["Inter"],
            "headline-lg-mobile": ["Inter"],
            "label-md": ["Inter"],
            "title-md": ["Inter"],
            "display-lg": ["Inter"],
            "code-md": ["Courier Prime"],
            "body-lg": ["Inter"],
            "headline-md": ["Inter"],
            "body-md": ["Inter"]
          },
          "fontSize": {
            "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
            "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
            "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.01em", "fontWeight": "500" }],
            "title-md": ["18px", { "lineHeight": "24px", "fontWeight": "500" }],
            "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
            "code-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
            "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
            "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
            "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }]
          }
        }
      }
    }
  </script>
</head>
<body class="bg-surface font-body-md text-body-md text-on-surface antialiased">
  
  <!-- Sidebar Navigation Drawer -->
  <aside class="fixed left-0 top-0 h-screen w-64 bg-surface-container-lowest border-r border-outline-variant/40 z-50 flex flex-col justify-between select-none -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-in-out" id="sidebar">
    <div class="flex flex-col">
      <div class="h-16 flex items-center justify-between px-lg border-b border-outline-variant/30">
        <div class="flex items-center gap-sm">
          <div class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary-fixed text-primary-container">
            <span class="material-symbols-outlined text-[20px]">receipt_long</span>
          </div>
          <div class="flex flex-col">
            <span class="font-headline-md text-headline-md text-on-surface tracking-tight leading-none text-[18px]">Papertrail</span>
            <span class="font-label-md text-label-md text-on-surface-variant leading-tight">e-receipts</span>
          </div>
        </div>
        <button class="lg:hidden text-on-surface-variant hover:text-on-surface p-1 rounded-lg" onclick="document.getElementById('sidebar').classList.add('-translate-x-full'); document.getElementById('sidebar-backdrop').classList.add('hidden');" type="button">
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>
      <nav class="flex flex-col gap-xs px-md pt-lg" data-active-classes="bg-primary-container text-on-primary font-title-md font-medium rounded-xl shadow-sm">
        <a class="flex items-center gap-md px-md py-sm rounded-xl font-body-md text-body-md text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors" data-path="dashboard" href="#">
          <span class="material-symbols-outlined text-[20px]">dashboard</span>
          <span>Dashboard</span>
        </a>
        <a class="flex items-center gap-md px-md py-sm rounded-xl font-body-md text-body-md text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors" data-path="receipts" href="#">
          <span class="material-symbols-outlined text-[20px]">receipt</span>
          <span>Receipts</span>
        </a>
        <a class="flex items-center gap-md px-md py-sm rounded-xl font-body-md text-body-md text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors" data-path="customers" href="#">
          <span class="material-symbols-outlined text-[20px]">group</span>
          <span>Customers</span>
        </a>
        <a class="flex items-center gap-md px-md py-sm rounded-xl font-body-md text-body-md text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors" data-path="templates" href="#">
          <span class="material-symbols-outlined text-[20px]">style</span>
          <span>Templates</span>
        </a>
        <a aria-current="page" class="flex items-center gap-md px-md py-sm transition-colors bg-primary-container text-on-primary font-title-md font-medium rounded-xl shadow-sm" data-path="settings" href="#">
          <span class="material-symbols-outlined text-[20px]">settings</span>
          <span>Settings</span>
        </a>
      </nav>
    </div>
    <div class="p-md border-t border-outline-variant/30">
      <div class="flex items-center justify-between p-sm rounded-xl hover:bg-surface-container transition-colors">
        <div class="flex items-center gap-sm">
          <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
          </div>
          <div class="flex flex-col truncate">
            <span class="font-title-md text-title-md text-[14px] text-on-surface font-medium truncate">Louis</span>
            <span class="font-label-md text-label-md text-on-surface-variant truncate">louis@business.co</span>
          </div>
        </div>
        <a class="text-on-surface-variant hover:text-error p-xs rounded-lg transition-colors flex items-center" data-path="login" href="#" title="Logout / Account">
          <span class="material-symbols-outlined text-[20px]">logout</span>
        </a>
      </div>
    </div>
  </aside>

  <!-- Mobile Backdrop Overlay -->
  <div class="fixed inset-0 bg-black/40 z-40 hidden lg:hidden transition-opacity" id="sidebar-backdrop" onclick="document.getElementById('sidebar').classList.add('-translate-x-full'); this.classList.add('hidden');"></div>

  <!-- Main Content Layout Area -->
  <div class="pl-0 lg:pl-64 transition-all duration-200">
    <header class="fixed top-0 left-0 lg:left-64 right-0 h-16 bg-surface-container-lowest/90 backdrop-blur-md border-b border-outline-variant/30 z-40 px-md sm:px-lg flex items-center justify-between gap-sm">
      <div class="flex items-center gap-sm w-full sm:w-80">
        <button class="lg:hidden p-sm text-on-surface-variant hover:text-on-surface rounded-xl focus:outline-none" onclick="document.getElementById('sidebar').classList.remove('-translate-x-full'); document.getElementById('sidebar-backdrop').classList.remove('hidden');" type="button">
          <span class="material-symbols-outlined text-[24px]">menu</span>
        </button>
        <div class="relative w-full">
          <span class="material-symbols-outlined absolute left-sm top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
          <input class="w-full h-10 pl-9 pr-md bg-surface-container-low rounded-xl border border-outline-variant/50 font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant/70 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-container/20 transition-all" placeholder="Search receipts, customers, IDs..." type="text"/>
        </div>
      </div>
      <div class="flex items-center gap-xs sm:gap-md shrink-0">
        <button class="inline-flex items-center gap-xs px-sm sm:px-md py-sm rounded-xl bg-primary-container hover:bg-primary text-on-primary font-title-md text-title-md text-[14px] font-medium shadow-sm transition-colors" type="button">
          <span class="material-symbols-outlined text-[18px]">add</span>
          <span class="hidden sm:inline">Create Receipt</span>
        </button>
        <div class="h-6 w-px bg-outline-variant/40 mx-xs hidden sm:block"></div>
        <button aria-label="Notifications" class="p-sm rounded-xl text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors hidden sm:block" type="button">
          <span class="material-symbols-outlined text-[20px]">notifications</span>
        </button>
        <button aria-label="Help &amp; Docs" class="p-sm rounded-xl text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors hidden sm:block" type="button">
          <span class="material-symbols-outlined text-[20px]">help_outline</span>
        </button>
        <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center cursor-pointer sm:ml-xs">
          <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
        </div>
      </div>
    </header>

    <main class="w-full pt-16 bg-surface px-sm sm:px-lg py-md sm:py-xl min-h-screen">
      <div class="flex flex-col w-full">
        <script>
          document.querySelectorAll('aside nav a').forEach(a => {
            if (a.getAttribute('data-path') === 'settings') {
              a.className = 'flex items-center gap-md px-md py-sm bg-primary-container text-on-primary font-title-md font-medium rounded-xl shadow-sm transition-colors';
            } else {
              a.className = 'flex items-center gap-md px-md py-sm rounded-xl font-body-md text-body-md text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors';
            }
          });
        </script>
        
        <div class="max-w-6xl w-full mx-auto flex flex-col gap-lg sm:gap-xl pb-24">
          <!-- Header Block -->
          <div class="flex flex-col md:flex-row md:items-end justify-between gap-md pb-xs sm:pb-md">
            <div class="flex flex-col gap-xs">
              <div class="flex items-center gap-sm">
                <span class="font-label-md text-label-md uppercase tracking-wider text-primary font-semibold">Workspace Settings</span>
                <span class="w-1 h-1 rounded-full bg-outline-variant"></span>
                <span class="font-code-md text-code-md text-on-surface-variant">v2.4.1</span>
              </div>
              <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight text-[24px] sm:text-[32px]">Settings</h1>
              <p class="font-body-md text-body-md text-on-surface-variant text-[13px] sm:text-[14px]">Manage your business profile, receipt defaults, tax preferences, and WhatsApp notifications.</p>
            </div>
            <div class="flex items-center gap-sm self-start md:self-auto bg-surface-container-low px-md py-xs rounded-full">
              <span class="w-2 h-2 rounded-full bg-primary-container animate-pulse"></span>
              <span class="font-label-md text-label-md text-on-surface-variant" id="autosave-indicator">Last saved 2 minutes ago</span>
            </div>
          </div>

          <!-- Segmented Tab Navigation -->
          <div class="bg-surface-container p-xs rounded-xl flex items-center gap-xs overflow-x-auto whitespace-nowrap">
            <button class="tab-btn active-tab flex items-center gap-xs px-md sm:px-lg py-sm rounded-lg font-title-md text-title-md text-[13px] sm:text-[14px] font-medium bg-surface-container-lowest text-on-surface shadow-sm transition-all shrink-0" data-tab="profile" type="button">
              <span class="material-symbols-outlined text-[18px] text-primary">storefront</span>
              <span>Business Profile</span>
            </button>
            <button class="tab-btn flex items-center gap-xs px-md sm:px-lg py-sm rounded-lg font-body-md text-body-md text-[13px] sm:text-[14px] text-on-surface-variant hover:text-on-surface transition-all shrink-0" data-tab="receipts" type="button">
              <span class="material-symbols-outlined text-[18px]">receipt_long</span>
              <span>Receipt Preferences</span>
            </button>
            <button class="tab-btn flex items-center gap-xs px-md sm:px-lg py-sm rounded-lg font-body-md text-body-md text-[13px] sm:text-[14px] text-on-surface-variant hover:text-on-surface transition-all shrink-0" data-tab="whatsapp" type="button">
              <span class="material-symbols-outlined text-[18px]">chat</span>
              <span>WhatsApp &amp; Delivery</span>
            </button>
            <button class="tab-btn flex items-center gap-xs px-md sm:px-lg py-sm rounded-lg font-body-md text-body-md text-[13px] sm:text-[14px] text-on-surface-variant hover:text-on-surface transition-all shrink-0" data-tab="team" type="button">
              <span class="material-symbols-outlined text-[18px]">shield_person</span>
              <span>Team &amp; Security</span>
            </button>
          </div>

          <!-- MAIN FORM WRAPPER -->
          <form class="flex flex-col gap-xl sm:gap-2xl" id="settings-form">
            <!-- SECTION 1: Business Profile -->
            <section class="flex flex-col gap-md sm:gap-lg" id="section-business">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div class="flex flex-col">
                  <span class="font-label-md text-label-md text-primary font-semibold uppercase tracking-wider">01. Identity &amp; Legal</span>
                  <h2 class="font-headline-md text-headline-md text-on-surface text-[20px] sm:text-[24px]">Business Information</h2>
                </div>
                <span class="font-label-md text-label-md px-sm py-xs rounded-lg bg-surface-container-high text-on-surface-variant font-medium self-start sm:self-auto">Public in Receipts</span>
              </div>
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-md sm:gap-lg">
                <!-- Logo Uploder Card (Bento Left) -->
                <div class="lg:col-span-4 bg-surface-container-lowest p-md sm:p-lg rounded-xl flex flex-col justify-between shadow-sm relative overflow-hidden group">
                  <div class="flex flex-col gap-xs">
                    <label class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider font-semibold">Brand Identity</label>
                    <span class="font-title-md text-title-md text-on-surface font-medium">Logo &amp; Watermark</span>
                    <p class="font-body-md text-body-md text-on-surface-variant text-[13px]">Shown on PDF receipts, dynamic URLs, and WhatsApp headers.</p>
                  </div>
                  <div class="my-md sm:my-lg flex flex-col items-center justify-center p-md sm:p-lg rounded-xl bg-surface-container-low text-center cursor-pointer hover:bg-surface-container transition-colors">
                    <div class="relative w-20 h-20 sm:w-24 sm:h-24 mb-md rounded-xl overflow-hidden bg-surface-container-lowest flex items-center justify-center shadow-sm">
                      <img class="w-full h-full object-cover" data-alt="Corporate minimalist logo mark monogram with deep blue navy abstract geometry on crisp clean white backdrop for fintech financial enterprise, studio lighting high end modern" src="https://lh3.googleusercontent.com/aida-public/AB6AXuBkgndcYpMXI2bf6UdldnLHnDnfgFo0VVXhJ0rx1csccwtztx_K_MVQHcpodPWlAi198fn_99pIsgMPL4VQTO_FZ5LP8VzfA8XV-O_RAF5SioFZJLHQZ0-MkJG0Y1yg9xhS72Ia9_IYNrtslgQv6LPnXya86VZlcUE7NBt3G-N-fNR3AypaDWGPwm0Jq39WiV1CMszdhHySmGG94RJx5Hh3W8qZKsBgmKNCiYxULMRwJkVY_cEwwA"/>
                      <div class="absolute inset-0 bg-primary/20 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center backdrop-blur-[2px]">
                        <span class="material-symbols-outlined text-on-primary">photo_camera</span>
                      </div>
                    </div>
                    <span class="font-title-md text-title-md text-[14px] text-on-surface font-medium">Papertrail / Louis Enterprise</span>
                    <span class="font-label-md text-label-md text-on-surface-variant mt-xs">Click to upload SVG, PNG (max 2MB)</span>
                  </div>
                  <div class="flex items-center justify-between pt-sm">
                    <span class="font-label-md text-label-md text-on-surface-variant">Recommended: 512x512px</span>
                    <button class="text-error font-label-md text-label-md hover:underline" type="button">Remove</button>
                  </div>
                </div>
                <!-- Fields Grid (Bento Right) -->
                <div class="lg:col-span-8 bg-surface-container-lowest p-md sm:p-lg rounded-xl shadow-sm flex flex-col gap-md sm:gap-lg">
                  <div class="grid grid-cols-1 md:grid-cols-2 gap-md">
                    <!-- Business Name -->
                    <div class="flex flex-col gap-xs md:col-span-2">
                      <label class="font-label-md text-label-md text-on-surface-variant" for="biz_name">Registered Business Name</label>
                      <input class="h-10 px-md rounded-lg bg-surface-container-low font-body-md text-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest transition-all" id="biz_name" type="text" value="Papertrail Inc. / Louis Enterprise"/>
                    </div>
                    <!-- Official Email -->
                    <div class="flex flex-col gap-xs">
                      <label class="font-label-md text-label-md text-on-surface-variant" for="biz_email">Official Billing Email</label>
                      <div class="relative flex items-center">
                        <span class="material-symbols-outlined absolute left-sm text-on-surface-variant text-[18px]">mail</span>
                        <input class="h-10 w-full pl-9 pr-md rounded-lg bg-surface-container-low font-body-md text-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest transition-all" id="biz_email" type="email" value="louis@business.co"/>
                      </div>
                    </div>
                    <!-- Support Phone -->
                    <div class="flex flex-col gap-xs">
                      <label class="font-label-md text-label-md text-on-surface-variant" for="biz_phone">Customer Support Phone</label>
                      <div class="relative flex items-center">
                        <span class="material-symbols-outlined absolute left-sm text-on-surface-variant text-[18px]">call</span>
                        <input class="h-10 w-full pl-9 pr-md rounded-lg bg-surface-container-low font-body-md text-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest transition-all" id="biz_phone" type="tel" value="+234 801 234 5678"/>
                      </div>
                    </div>
                    <!-- Physical Address -->
                    <div class="flex flex-col gap-xs md:col-span-2">
                      <label class="font-label-md text-label-md text-on-surface-variant" for="biz_addr">Physical Store / Headquarters Address</label>
                      <input class="h-10 px-md rounded-lg bg-surface-container-low font-body-md text-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest transition-all" id="biz_addr" type="text" value="Plot 4B, Admiralty Way, Lekki Phase 1, Lagos, Nigeria"/>
                    </div>
                    <!-- Website / Social -->
                    <div class="flex flex-col gap-xs">
                      <label class="font-label-md text-label-md text-on-surface-variant" for="biz_web">Website or Social Handle</label>
                      <div class="relative flex items-center">
                        <span class="material-symbols-outlined absolute left-sm text-on-surface-variant text-[18px]">globe</span>
                        <input class="h-10 w-full pl-9 pr-md rounded-lg bg-surface-container-low font-body-md text-body-md text-on-surface focus:outline-none focus:bg-surface-container-lowest transition-all" id="biz_web" type="text" value="instagram.com/papertrail_ng"/>
                      </div>
                    </div>
                    <!-- TIN / RC -->
                    <div class="flex flex-col gap-xs">
                      <div class="flex items-center justify-between">
                        <label class="font-label-md text-label-md text-on-surface-variant" for="biz_tin">Tax ID (TIN) / RC Number</label>
                        <span class="material-symbols-outlined text-[14px] text-on-surface-variant" title="Required for compliant fiscal receipts">info</span>
                      </div>
                      <div class="relative flex items-center">
                        <span class="material-symbols-outlined absolute left-sm text-on-surface-variant text-[18px]">badge</span>
                        <input class="h-10 w-full pl-9 pr-md rounded-lg bg-surface-container-low font-code-md text-code-md text-on-surface focus:outline-none focus:bg-surface-container-lowest transition-all uppercase" id="biz_tin" type="text" value="RC-1948502"/>
                      </div>
                    </div>
                  </div>
                </div>
              </div>
            </section>

            <!-- SECTION 2: Receipt Configuration -->
            <section class="flex flex-col gap-md sm:gap-lg" id="section-receipts">
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <div class="flex flex-col">
                  <span class="font-label-md text-label-md text-primary font-semibold uppercase tracking-wider">02. Formatting &amp; Ledger</span>
                  <h2 class="font-headline-md text-headline-md text-on-surface text-[20px] sm:text-[24px]">Receipt Configuration</h2>
                </div>
                <span class="font-label-md text-label-md px-sm py-xs rounded-lg bg-secondary-container text-on-secondary-container font-medium self-start sm:self-auto">Applied to new receipts</span>
              </div>
              <div class="grid grid-cols-1 lg:grid-cols-12 gap-md sm:gap-lg">
                <!-- Left Column: Currency, Prefix, Tax -->
