<% if (user) { %>
<aside id="sidebar"
  class="fixed left-0 top-0 h-screen w-64 bg-surface-container-lowest border-r border-outline-variant/40 z-50 flex flex-col justify-between select-none -translate-x-full lg:translate-x-0 transition-transform duration-200 ease-in-out">

  <div class="flex flex-col">
    <div class="h-16 flex items-center justify-between px-lg border-b border-outline-variant/30">
      <div class="flex items-center gap-sm">
        <div class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary-fixed text-primary-container">
          <span class="material-symbols-outlined text-[20px]">receipt_long</span>
        </div>
        <div class="flex flex-col">
          <span class="font-headline-md text-headline-md text-on-surface tracking-tight leading-none text-[18px]">Papertrail</span>
          <span class="font-label-md text-label-md text-on-surface-variant leading-tight">e-receipts</span>
        </div>
      </div>
      <button class="lg:hidden text-on-surface-variant hover:text-on-surface p-1 rounded-lg"
        onclick="document.getElementById('sidebar').classList.add('-translate-x-full'); document.getElementById('sidebar-backdrop').classList.add('hidden');"
        type="button">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <nav class="flex flex-col gap-xs px-md pt-lg">
      <%
        const items = [
          { path: 'dashboard', label: 'Dashboard', icon: 'dashboard' },
          { path: 'receipts',  label: 'Receipts',  icon: 'receipt'   },
          { path: 'customers', label: 'Customers', icon: 'group'     },
          { path: 'templates', label: 'Templates', icon: 'style'     },
          { path: 'settings',  label: 'Settings',  icon: 'settings'  },
        ];
      %>
      <% items.forEach(item => { %>
        <% const active = (typeof activePage !== 'undefined') && activePage === item.path; %>
        <a href="/<%= item.path %>" data-path="<%= item.path %>"
           class="flex items-center gap-md px-md py-sm rounded-xl transition-colors
             <%= active
                ? 'bg-primary-container text-on-primary font-title-md font-medium shadow-sm'
                : 'font-body-md text-body-md text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface' %>">
          <span class="material-symbols-outlined text-[20px]"><%= item.icon %></span>
          <span><%= item.label %></span>
        </a>
      <% }) %>
    </nav>
  </div>

  <div class="p-md border-t border-outline-variant/30">
    <div class="flex items-center justify-between p-sm rounded-xl hover:bg-surface-container transition-colors">
      <div class="flex items-center gap-sm">
        <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center flex-shrink-0">
          <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
        </div>
        <div class="flex flex-col truncate">
          <span class="font-title-md text-title-md text-[14px] text-on-surface font-medium truncate"><%= user.name %></span>
          <span class="font-label-md text-label-md text-on-surface-variant truncate"><%= user.email %></span>
        </div>
      </div>
      <form action="/logout" method="POST" class="inline">
        <button type="submit"
          class="text-on-surface-variant hover:text-error p-xs rounded-lg transition-colors flex items-center"
          title="Logout">
          <span class="material-symbols-outlined text-[20px]">logout</span>
        </button>
      </form>
    </div>
  </div>
</aside>
<% } %>