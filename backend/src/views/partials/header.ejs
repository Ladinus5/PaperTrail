<header class="h-16 bg-surface-container-lowest border-b border-outline-variant/30 flex items-center justify-between w-full px-md sm:px-lg shrink-0 sticky top-0 z-30">

  <!-- Left: mobile menu + brand + search -->
  <div class="flex items-center gap-sm">
    <button type="button"
      class="md:hidden p-sm text-on-surface-variant hover:bg-surface-container rounded-lg"
      onclick="document.getElementById('sidebar').classList.remove('-translate-x-full'); document.getElementById('sidebar-backdrop').classList.remove('hidden');">
      <span class="material-symbols-outlined text-[24px]">menu</span>
    </button>

    <span class="md:hidden text-title-md font-bold text-primary">Papertrail</span>

    <div class="hidden md:flex relative w-64">
      <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[20px]">search</span>
      <input type="text" placeholder="Search..."
        class="w-full h-10 pl-10 pr-3 bg-surface-container-low border border-outline-variant/50 rounded-lg text-body-md text-on-surface placeholder:text-on-surface-variant/70 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-container/20 transition-all"/>
    </div>
  </div>

  <!-- Right: create + actions + avatar -->
  <div class="flex items-center gap-3 sm:gap-md">
    <a href="/receipts/new"
      class="hidden md:flex bg-primary-container hover:bg-primary text-on-primary text-label-md font-semibold rounded-lg py-2 px-4 transition-colors items-center gap-1 shadow-sm">
      + Create Receipt
    </a>

    <div class="flex items-center gap-1">
      <button type="button" class="p-sm text-primary hover:bg-surface-container rounded-full transition-colors">
        <span class="material-symbols-outlined">notifications</span>
      </button>
      <button type="button" class="p-sm text-primary hover:bg-surface-container rounded-full transition-colors">
        <span class="material-symbols-outlined">help_outline</span>
      </button>
    </div>

    <div class="hidden md:flex w-8 h-8 rounded-full bg-primary items-center justify-center cursor-pointer hover:ring-2 hover:ring-primary-container transition-all">
      <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
    </div>
  </div>
</header>