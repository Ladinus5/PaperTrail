<main class="w-full pt-16 bg-surface px-md sm:px-lg py-md sm:py-xl min-h-screen">
  <div class="flex flex-col w-full">
    <div class="max-w-[1400px] w-full mx-auto space-y-6">

      <!-- Page Header + Controls -->
      <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <div class="flex items-center gap-2">
            <span class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Customers</span>
            <span class="px-2.5 py-0.5 rounded-full text-label-md font-label-md bg-secondary-container text-on-secondary-fixed-variant font-medium">Directory</span>
          </div>
          <p class="font-body-md text-body-md text-on-surface-variant mt-1">Manage your client contacts, transaction history, and contact details.</p>
        </div>
        <div class="flex flex-wrap sm:flex-nowrap items-center gap-2.5 sm:gap-3">
          <div class="relative w-full sm:w-auto flex-1 sm:flex-none">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
            <input id="customerSearch" type="text" placeholder="Search customers..."
              class="h-10 pl-9 pr-4 w-full sm:w-64 md:w-72 bg-surface-container-lowest rounded-lg border border-outline-variant/60 font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:border-primary-container focus:ring-2 focus:ring-primary-container/20 transition-all shadow-sm"/>
          </div>
          <button type="button"
            class="h-10 px-3.5 bg-surface-container-lowest border border-outline-variant/60 rounded-lg text-on-surface hover:bg-surface-container-low transition-colors font-label-md text-label-md flex items-center gap-2 shadow-sm">
            <span class="material-symbols-outlined text-[18px] text-secondary">tune</span>
            <span>Filter</span>
            <span class="material-symbols-outlined text-[16px] text-outline">expand_more</span>
          </button>
          <button type="button" id="openAddCustomerBtn"
            class="h-10 px-4 bg-primary-container hover:bg-primary text-on-primary rounded-lg font-title-md text-title-md text-[14px] font-medium inline-flex items-center gap-1.5 shadow-sm transition-all hover:shadow ml-auto sm:ml-0">
            <span class="material-symbols-outlined text-[18px]">add</span>
            <span class="whitespace-nowrap">Add Customer</span>
          </button>
        </div>
      </div>

      <!-- Summary Metrics -->
      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 sm:gap-5">
        <div class="p-5 rounded-xl bg-surface-container-lowest border border-outline-variant/40 shadow-sm relative overflow-hidden flex flex-col justify-between">
          <div class="flex items-start justify-between">
            <div class="flex flex-col">
              <span class="font-label-md text-label-md text-secondary tracking-wide uppercase font-medium">Total Customers</span>
              <span class="font-display-lg text-display-lg text-on-surface mt-1 tracking-tight"><%= totalCount %></span>
            </div>
            <div class="w-10 h-10 rounded-lg bg-secondary-fixed flex items-center justify-center text-primary">
              <span class="material-symbols-outlined text-[22px]">group</span>
            </div>
          </div>
          <div class="flex items-center gap-1.5 mt-3 pt-3 border-t border-outline-variant/20 font-label-md text-label-md text-on-surface-variant">
            <span class="text-secondary font-body-md text-body-md text-[13px]">All registered contacts</span>
          </div>
        </div>

        <div class="p-5 rounded-xl bg-surface-container-lowest border border-outline-variant/40 shadow-sm relative overflow-hidden flex flex-col justify-between">
          <div class="flex items-start justify-between">
            <div class="flex flex-col">
              <span class="font-label-md text-label-md text-secondary tracking-wide uppercase font-medium">Active Customers</span>
              <span class="font-display-lg text-display-lg text-on-surface mt-1 tracking-tight">0</span>
            </div>
            <div class="w-10 h-10 rounded-lg bg-[#e0f2fe] flex items-center justify-center text-[#0284c7]">
              <span class="material-symbols-outlined text-[22px]">shopping_cart_checkout</span>
            </div>
          </div>
          <div class="flex items-center gap-1.5 mt-3 pt-3 border-t border-outline-variant/20 font-label-md text-label-md text-on-surface-variant">
            <span class="w-2 h-2 rounded-full bg-[#16a34a]"></span>
            <span class="text-secondary font-body-md text-body-md text-[13px]">Purchased within last 30 days</span>
          </div>
        </div>

        <div class="p-5 rounded-xl bg-surface-container-lowest border border-outline-variant/40 shadow-sm relative overflow-hidden flex flex-col justify-between sm:col-span-2 md:col-span-1">
          <div class="flex items-start justify-between">
            <div class="flex flex-col">
              <span class="font-label-md text-label-md text-secondary tracking-wide uppercase font-medium">Avg. Revenue / Customer</span>
              <span class="font-display-lg text-display-lg text-on-surface mt-1 tracking-tight">₦0</span>
            </div>
            <div class="w-10 h-10 rounded-lg bg-primary-fixed flex items-center justify-center text-primary-container">
              <span class="material-symbols-outlined text-[22px]">payments</span>
            </div>
          </div>
          <div class="flex items-center gap-1.5 mt-3 pt-3 border-t border-outline-variant/20 font-label-md text-label-md text-on-surface-variant">
            <span class="text-secondary font-body-md text-body-md text-[13px]">Across all receipts</span>
          </div>
        </div>
      </div>

      <!-- Workspace -->
      <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">

        <!-- Table -->
        <div class="xl:col-span-8 bg-surface-container-lowest rounded-xl border border-outline-variant/40 shadow-sm overflow-hidden flex flex-col">
          <div class="px-5 py-4 border-b border-outline-variant/30 flex items-center justify-between bg-surface-container-low/40">
            <div class="flex items-center gap-3">
              <span class="font-title-md text-title-md text-on-surface font-semibold">Customer Records</span>
              <span class="px-2 py-0.5 rounded bg-surface-container text-secondary text-label-md font-label-md"><%= totalCount %> total</span>
            </div>
            <div class="flex items-center gap-2">
              <button type="button" class="p-1.5 rounded text-secondary hover:bg-surface-container transition-colors" title="Export List">
                <span class="material-symbols-outlined text-[20px]">download</span>
              </button>
              <button type="button" class="p-1.5 rounded text-secondary hover:bg-surface-container transition-colors" title="Table View Settings">
                <span class="material-symbols-outlined text-[20px]">view_column</span>
              </button>
            </div>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse min-w-[640px]">
              <thead>
                <tr class="bg-surface-container-low/70 border-b border-outline-variant/30 text-secondary uppercase font-label-md text-label-md tracking-wider">
                  <th class="py-3 px-4 font-semibold">Customer</th>
                  <th class="py-3 px-4 font-semibold">Contact Info</th>
                  <th class="py-3 px-4 font-semibold text-center">Receipts</th>
                  <th class="py-3 px-4 font-semibold text-right">Total Spent</th>
                  <th class="py-3 px-4 font-semibold">Last Activity</th>
                  <th class="py-3 px-4 text-center font-semibold">Actions</th>
                </tr>
              </thead>
              <tbody class="font-body-md text-body-md text-on-surface divide-y divide-outline-variant/20" id="customersTableBody">

                <% if (customers.length === 0) { %>
                  <tr>
                    <td colspan="6" class="py-xl px-lg text-center">
                      <span class="material-symbols-outlined text-[48px] text-on-surface-variant/40 mb-sm block">group</span>
                      <p class="text-body-md text-on-surface-variant mb-md">No customers yet.</p>
                      <button type="button" id="emptyAddCustomerBtn"
                        class="inline-flex items-center gap-1 bg-primary-container hover:bg-primary text-on-primary px-md py-sm rounded-lg text-label-md font-semibold transition-colors">
                        <span class="material-symbols-outlined text-[16px]">add</span>
                        Add your first customer
                      </button>
                    </td>
                  </tr>
                <% } else { %>
                  <% customers.forEach((c, i) => { %>
                    <tr class="customer-row hover:bg-surface-container-low/60 cursor-pointer transition-colors <%= i === 0 ? 'bg-primary-fixed/20 border-l-4 border-l-primary-container' : '' %>"
                        data-customer='<%= JSON.stringify({
                          id: c.id,
                          name: c.name,
                          initials: c.initials,
                          phone: c.phone || "",
                          email: c.email || "",
                          receiptCount: c.receiptCount,
                          lifetimeSpend: c.lifetimeSpend,
                          lastActivity: c.lastActivity
                        }) %>'>
                      <td class="py-3.5 px-4">
                        <div class="flex items-center gap-3">
                          <div class="w-9 h-9 rounded-full bg-primary text-on-primary font-title-md text-title-md text-[13px] flex items-center justify-center font-semibold">
                            <%= c.initials %>
                          </div>
                          <div class="flex flex-col">
                            <span class="font-title-md text-title-md text-[14px] font-semibold text-on-surface"><%= c.name %></span>
                            <span class="text-secondary text-[12px]"><%= c.email || "—" %></span>
                          </div>
                        </div>
                      </td>
                      <td class="py-3.5 px-4 font-code-md text-code-md text-[13px]">
                        <div class="flex flex-col">
                          <span class="text-on-surface"><%= c.phone || "—" %></span>
                          <span class="text-secondary font-body-md text-body-md text-[12px]"><%= c.email || "—" %></span>
                        </div>
                      </td>
                      <td class="py-3.5 px-4 text-center">
                        <span class="px-2.5 py-1 rounded-full bg-surface-container text-on-surface font-medium text-[12px]"><%= c.receiptCount %> receipts</span>
                      </td>
                      <td class="py-3.5 px-4 text-right font-semibold text-on-surface font-code-md text-[13px]">
                        <%= formatCurrency(c.lifetimeSpend) %>
                      </td>
                      <td class="py-3.5 px-4">
                        <% if (c.receiptCount > 0) { %>
                          <div class="flex items-center gap-1.5">
                            <span class="w-1.5 h-1.5 rounded-full bg-[#16a34a]"></span>
                            <span class="text-on-surface font-medium"><%= timeAgo(c.lastActivity) %></span>
                          </div>
                        <% } else { %>
                          <span class="text-secondary">Never</span>
                        <% } %>
                      </td>
                      <td class="py-3.5 px-4">
                        <div class="flex items-center justify-center gap-1">
                          <% if (c.phone) { %>
                            <a href="https://wa.me/<%= c.phone.replace(/\D/g, '').replace(/^0/, '234') %>" target="_blank" onclick="event.stopPropagation()"
                              class="p-1.5 rounded-lg text-[#15803d] hover:bg-[#dcfce7] transition-colors" title="Chat on WhatsApp">
                              <span class="material-symbols-outlined text-[18px]">chat</span>
                            </a>
                          <% } %>
                          <a href="/receipts/new?customer=<%= c.id %>" onclick="event.stopPropagation()"
                            class="p-1.5 rounded-lg text-primary-container hover:bg-primary-fixed transition-colors" title="New Receipt">
                            <span class="material-symbols-outlined text-[18px]">receipt_long</span>
                          </a>
                          <button type="button" onclick="event.stopPropagation()"
                            class="p-1.5 rounded-lg text-secondary hover:bg-surface-container transition-colors" title="Options">
                            <span class="material-symbols-outlined text-[18px]">more_vert</span>
                          </button>
                        </div>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>

              </tbody>
            </table>
          </div>

          <div class="px-5 py-3 border-t border-outline-variant/30 flex flex-col sm:flex-row items-center justify-between gap-3 bg-surface-container-lowest text-label-md font-label-md text-secondary">
            <span>Showing <strong class="text-on-surface"><%= customers.length %></strong> of <strong class="text-on-surface"><%= totalCount %></strong> customers</span>
            <div class="flex items-center gap-1.5">
              <button type="button" disabled class="px-3 py-1.5 rounded border border-outline-variant/50 hover:bg-surface-container transition-colors disabled:opacity-50">Previous</button>
              <button type="button" class="px-3 py-1.5 rounded bg-primary-container text-on-primary font-medium">1</button>
              <button type="button" disabled class="px-3 py-1.5 rounded border border-outline-variant/50 hover:bg-surface-container transition-colors disabled:opacity-50">Next</button>
            </div>
          </div>
        </div>

        <!-- Detail Pane -->
        <div class="xl:col-span-4 bg-surface-container-lowest rounded-xl border border-outline-variant/40 shadow-sm p-4 sm:p-6 flex flex-col gap-6" id="customerDetailPane">

          <div id="detailEmpty" class="<%= customers.length === 0 ? '' : 'hidden' %> flex flex-col items-center justify-center py-16 text-center">
            <span class="material-symbols-outlined text-[48px] text-on-surface-variant/40 mb-sm">person_search</span>
            <p class="font-title-md text-title-md text-on-surface-variant">Select a customer</p>
            <p class="font-body-md text-body-md text-on-surface-variant/70 text-[13px] mt-1">Click a row to view details</p>
          </div>

          <div id="detailBody" class="<%= customers.length === 0 ? 'hidden' : '' %> flex flex-col gap-6">

            <div class="flex items-start justify-between">
              <div class="flex items-center gap-3.5">
                <div class="w-14 h-14 rounded-full bg-primary text-on-primary font-headline-md text-headline-md flex items-center justify-center font-semibold shadow-sm flex-shrink-0" id="detailAvatar">—</div>
                <div class="flex flex-col">
                  <span class="font-headline-md text-headline-md text-on-surface leading-tight text-[20px]" id="detailName">—</span>
                  <span class="text-label-md font-label-md text-primary-container font-semibold uppercase tracking-wider mt-0.5" id="detailTag">Customer</span>
                </div>
              </div>
              <button type="button" class="p-2 rounded-lg text-secondary hover:bg-surface-container transition-colors" title="Edit Customer">
                <span class="material-symbols-outlined text-[20px]">edit</span>
              </button>
            </div>

            <div class="p-4 rounded-xl bg-surface-container-low/70 border border-outline-variant/30 space-y-3">
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-on-surface-variant font-body-md text-body-md truncate mr-2">
                  <span class="material-symbols-outlined text-[18px] text-secondary flex-shrink-0">phone</span>
                  <span class="font-code-md text-code-md text-on-surface font-medium truncate" id="detailPhone">—</span>
                </div>
                <button type="button" class="text-outline hover:text-on-surface flex-shrink-0" id="copyPhoneBtn" title="Copy Phone">
                  <span class="material-symbols-outlined text-[16px]">content_copy</span>
                </button>
              </div>
              <div class="flex items-center justify-between">
                <div class="flex items-center gap-2 text-on-surface-variant font-body-md text-body-md truncate mr-2">
                  <span class="material-symbols-outlined text-[18px] text-secondary flex-shrink-0">mail</span>
                  <span class="font-code-md text-code-md text-on-surface font-medium truncate" id="detailEmail">—</span>
                </div>
                <button type="button" class="text-outline hover:text-on-surface flex-shrink-0" id="copyEmailBtn" title="Copy Email">
                  <span class="material-symbols-outlined text-[16px]">content_copy</span>
                </button>
              </div>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
              <a id="detailWhatsApp" href="#" target="_blank"
                class="h-10 px-3 rounded-lg bg-[#25d366]/15 hover:bg-[#25d366]/25 text-[#075e54] font-title-md text-title-md text-[13px] font-semibold flex items-center justify-center gap-1.5 transition-colors border border-[#25d366]/30">
                <span class="material-symbols-outlined text-[18px]">chat</span>
                <span>WhatsApp Chat</span>
              </a>
              <a id="detailNewReceiptBtn" href="#"
                class="h-10 px-3 rounded-lg bg-primary-container hover:bg-primary text-on-primary font-title-md text-title-md text-[13px] font-semibold flex items-center justify-center gap-1.5 transition-colors shadow-sm">
                <span class="material-symbols-outlined text-[18px]">post_add</span>
                <span>New Receipt</span>
              </a>
            </div>

            <div class="grid grid-cols-2 gap-3 py-3 border-y border-outline-variant/30">
              <div class="flex flex-col">
                <span class="text-label-md font-label-md text-secondary uppercase font-medium">Lifetime Spend</span>
                <span class="font-title-md text-title-md text-[18px] font-bold text-on-surface mt-0.5" id="detailTotalSpent">—</span>
              </div>
              <div class="flex flex-col">
                <span class="text-label-md font-label-md text-secondary uppercase font-medium">Total Invoices</span>
                <span class="font-title-md text-title-md text-[18px] font-bold text-on-surface mt-0.5" id="detailReceiptCount">—</span>
              </div>
            </div>

            <div class="flex flex-col space-y-3">
              <div class="flex items-center justify-between">
                <span class="font-title-md text-title-md text-[15px] font-semibold text-on-surface">Recent Receipts</span>
                <a id="detailViewAllLink" href="/receipts" class="font-label-md text-label-md text-primary-container hover:underline font-semibold">View All</a>
              </div>
              <div class="text-body-md text-on-surface-variant text-[13px] text-center py-4">No receipts yet</div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Add Customer Modal -->
<div id="addCustomerModal" class="hidden fixed inset-0 z-[60] flex items-center justify-center p-md">
  <!-- Backdrop -->
  <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="closeAddCustomerModal()"></div>

  <!-- Modal Card -->
  <div class="relative bg-surface-container-lowest rounded-2xl shadow-2xl w-full max-w-md overflow-hidden">

    <!-- Header -->
    <div class="flex items-center justify-between p-lg border-b border-outline-variant/30">
      <div class="flex items-center gap-sm">
        <div class="w-9 h-9 rounded-lg bg-primary-fixed text-primary-container flex items-center justify-center">
          <span class="material-symbols-outlined text-[20px]">person_add</span>
        </div>
        <div class="flex flex-col">
          <span class="font-title-md text-title-md text-on-surface font-semibold">Add Customer</span>
          <span class="font-label-md text-label-md text-on-surface-variant">Create a new customer record</span>
        </div>
      </div>
      <button type="button" onclick="closeAddCustomerModal()"
        class="p-sm rounded-lg text-on-surface-variant hover:bg-surface-container transition-colors">
        <span class="material-symbols-outlined text-[20px]">close</span>
      </button>
    </div>

    <!-- Body -->
    <form id="addCustomerForm" class="p-lg space-y-md">
      <div id="addCustomerError"
           class="hidden p-md rounded-lg bg-error-container text-on-error-container font-body-md text-body-md border border-error/30"></div>

      <div class="flex flex-col gap-xs">
        <label class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider" for="newCustomerName">
          Full Name <span class="text-error">*</span>
        </label>
        <div class="relative">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">person</span>
          <input id="newCustomerName" name="name" type="text" required
            placeholder="e.g. John Doe"
            class="w-full h-10 pl-9 pr-md rounded-lg bg-surface-container-low font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant/60 focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary-container/20 transition-all"/>
        </div>
      </div>

      <div class="flex flex-col gap-xs">
        <label class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider" for="newCustomerEmail">Email</label>
        <div class="relative">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">mail</span>
          <input id="newCustomerEmail" name="email" type="email"
            placeholder="name@example.com"
            class="w-full h-10 pl-9 pr-md rounded-lg bg-surface-container-low font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant/60 focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary-container/20 transition-all"/>
        </div>
      </div>

      <div class="flex flex-col gap-xs">
        <label class="font-label-md text-label-md text-on-surface-variant uppercase tracking-wider" for="newCustomerPhone">Phone</label>
        <div class="relative">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">call</span>
          <input id="newCustomerPhone" name="phone" type="tel"
            placeholder="080 1234 5678"
            class="w-full h-10 pl-9 pr-md rounded-lg bg-surface-container-low font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant/60 focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary-container/20 transition-all font-code-md"/>
        </div>
      </div>
    </form>

    <!-- Footer -->
    <div class="flex items-center justify-end gap-sm p-lg border-t border-outline-variant/30 bg-surface-container-low/40">
      <button type="button" onclick="closeAddCustomerModal()"
        class="h-10 px-md rounded-lg font-title-md text-title-md text-[14px] font-medium text-on-surface-variant hover:bg-surface-container transition-colors">
        Cancel
      </button>
      <button type="submit" form="addCustomerForm" id="addCustomerSubmitBtn"
        class="h-10 px-md rounded-lg bg-primary-container hover:bg-primary text-on-primary font-title-md text-title-md text-[14px] font-medium shadow-sm transition-all flex items-center gap-1.5">
        <span class="material-symbols-outlined text-[18px]">check</span>
        <span>Add Customer</span>
      </button>
    </div>

  </div>
</div>

</main>

<script>
  function fmtCurrency(n) {
    return '₦' + Number(n || 0).toLocaleString('en-NG', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
  }
  function copyToClipboard(text) {
    if (text && text !== '—') navigator.clipboard.writeText(text);
  }

  function selectCustomerFromRow(rowEl) {
    const data = JSON.parse(rowEl.getAttribute('data-customer') || '{}');
    const phone = data.phone || '—';
    const email = data.email || '—';

    document.getElementById('detailAvatar').innerText = data.initials || '?';
    document.getElementById('detailName').innerText = data.name || '—';
    document.getElementById('detailPhone').innerText = phone;
    document.getElementById('detailEmail').innerText = email;
    document.getElementById('detailTotalSpent').innerText = fmtCurrency(data.lifetimeSpend);
    document.getElementById('detailReceiptCount').innerText = (data.receiptCount || 0) + ' Receipts';

    const wa = document.getElementById('detailWhatsApp');
    if (data.phone) {
      const clean = data.phone.replace(/\D/g, '').replace(/^0/, '234');
      wa.href = 'https://wa.me/' + clean;
      wa.classList.remove('opacity-40', 'pointer-events-none');
    } else {
      wa.href = '#';
      wa.classList.add('opacity-40', 'pointer-events-none');
    }

    document.getElementById('detailNewReceiptBtn').href = '/receipts/new?customer=' + (data.id || '');
    document.getElementById('detailViewAllLink').href = '/receipts?customer=' + (data.id || '');

    document.getElementById('copyPhoneBtn').onclick = () => copyToClipboard(phone);
    document.getElementById('copyEmailBtn').onclick = () => copyToClipboard(email);

    document.getElementById('detailEmpty').classList.add('hidden');
    document.getElementById('detailBody').classList.remove('hidden');

    document.querySelectorAll('#customersTableBody tr.customer-row').forEach(r => {
      r.classList.remove('bg-primary-fixed/20', 'border-l-4', 'border-l-primary-container');
    });
    rowEl.classList.add('bg-primary-fixed/20', 'border-l-4', 'border-l-primary-container');
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('#customersTableBody tr.customer-row').forEach(row => {
      row.addEventListener('click', () => selectCustomerFromRow(row));
    });

    const firstRow = document.querySelector('#customersTableBody tr.customer-row');
    if (firstRow) selectCustomerFromRow(firstRow);

    // Live search filter
    const searchInput = document.getElementById('customerSearch');
    if (searchInput) {
      searchInput.addEventListener('input', (e) => {
        const q = e.target.value.toLowerCase().trim();
        document.querySelectorAll('#customersTableBody tr.customer-row').forEach(row => {
          const text = row.innerText.toLowerCase();
          row.style.display = text.includes(q) ? '' : 'none';
        });
      });
    }
  });

  // ─── Add Customer Modal ───
const addModal = document.getElementById('addCustomerModal');
const addForm = document.getElementById('addCustomerForm');
const addError = document.getElementById('addCustomerError');
const addSubmitBtn = document.getElementById('addCustomerSubmitBtn');

function openAddCustomerModal() {
  addError.classList.add('hidden');
  addError.textContent = '';
  addForm.reset();
  addModal.classList.remove('hidden');
  setTimeout(() => document.getElementById('newCustomerName').focus(), 50);
}

function closeAddCustomerModal() {
  addModal.classList.add('hidden');
}

// Wire up all triggers
document.getElementById('openAddCustomerBtn')?.addEventListener('click', openAddCustomerModal);
document.getElementById('emptyAddCustomerBtn')?.addEventListener('click', openAddCustomerModal);

// Close on Escape
document.addEventListener('keydown', (e) => {
  if (e.key === 'Escape' && !addModal.classList.contains('hidden')) {
    closeAddCustomerModal();
  }
});

// Submit
addForm.addEventListener('submit', async (e) => {
  e.preventDefault();
  addError.classList.add('hidden');

  const payload = {
    name: document.getElementById('newCustomerName').value.trim(),
    email: document.getElementById('newCustomerEmail').value.trim() || null,
    phone: document.getElementById('newCustomerPhone').value.trim() || null,
  };

  if (!payload.name) {
    addError.textContent = 'Name is required';
    addError.classList.remove('hidden');
    return;
  }

  addSubmitBtn.disabled = true;
  addSubmitBtn.innerHTML = '<span class="material-symbols-outlined text-[18px] animate-spin">sync</span><span>Saving...</span>';

  try {
    const res = await fetch('/api/customers', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      credentials: 'include',
      body: JSON.stringify(payload),
    });

    const raw = await res.text();
    let data;
    try { data = JSON.parse(raw); } catch { throw new Error('Server error — please try again.'); }

    if (!res.ok || !data.success) {
      throw new Error(data.message || 'Failed to create customer');
    }

    // Success — reload the page so the new row appears
    window.location.reload();

  } catch (err) {
    addError.textContent = err.message;
    addError.classList.remove('hidden');

    addSubmitBtn.disabled = false;
    addSubmitBtn.innerHTML = '<span class="material-symbols-outlined text-[18px]">check</span><span>Add Customer</span>';
  }
});

</script>