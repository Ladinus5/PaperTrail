<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Courier+Prime&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
  <style>
    @layer base {
      html, body { margin: 0; padding: 0; }
      body { overscroll-behavior: none; }
      main > :first-child { margin-top: 0 !important; }
      main > :last-child { margin-bottom: 0 !important; }
    }
    ::-webkit-scrollbar { display: none; }
  </style>
  <script src="https://cdn.tailwindcss.com"></script>
  <script id="tailwind-config">
    tailwind.config = {
      "darkMode": "class",
      "theme": {
        "extend": {
          "colors": {
            "surface-variant": "#e2e2eb",
            "secondary-container": "#dce2f3",
            "on-primary-fixed-variant": "#00429b",
            "surface-bright": "#faf8ff",
            "on-tertiary-fixed-variant": "#7f2b00",
            "tertiary-fixed-dim": "#ffb599",
            "on-primary": "#ffffff",
            "on-background": "#191b22",
            "outline-variant": "#c3c6d5",
            "surface-container-lowest": "#ffffff",
            "primary-fixed": "#d9e2ff",
            "secondary-fixed-dim": "#c0c7d6",
            "tertiary": "#682200",
            "tertiary-fixed": "#ffdbce",
            "on-error-container": "#93000a",
            "on-tertiary": "#ffffff",
            "background": "#faf8ff",
            "on-tertiary-container": "#ffaf90",
            "on-primary-fixed": "#001945",
            "tertiary-container": "#8e3100",
            "on-primary-container": "#a9c1ff",
            "inverse-surface": "#2e3037",
            "on-secondary": "#ffffff",
            "surface-container-highest": "#e2e2eb",
            "on-surface": "#191b22",
            "inverse-on-surface": "#f0f0f9",
            "on-secondary-fixed": "#151c27",
            "surface-tint": "#215abd",
            "error-container": "#ffdad6",
            "surface": "#faf8ff",
            "secondary-fixed": "#dce2f3",
            "surface-container": "#ededf6",
            "surface-container-high": "#e7e7f0",
            "inverse-primary": "#b0c6ff",
            "on-tertiary-fixed": "#370e00",
            "primary-container": "#004aad",
            "primary-fixed-dim": "#b0c6ff",
            "on-secondary-fixed-variant": "#404754",
            "surface-dim": "#d9d9e2",
            "secondary": "#585f6c",
            "outline": "#737784",
            "on-secondary-container": "#5e6572",
            "on-error": "#ffffff",
            "surface-container-low": "#f3f3fc",
            "primary": "#00357f",
            "on-surface-variant": "#434653",
            "error": "#ba1a1a"
          },
          "borderRadius": {
            "DEFAULT": "0.125rem",
            "lg": "0.25rem",
            "xl": "0.5rem",
            "full": "0.75rem"
          },
          "spacing": {
            "margin-desktop": "40px",
            "lg": "24px",
            "gutter": "24px",
            "2xl": "48px",
            "xl": "32px",
            "md": "16px",
            "margin-mobile": "16px",
            "sm": "8px",
            "xs": "4px",
            "base": "4px"
          },
          "fontFamily": {
            "headline-lg": ["Inter"],
            "headline-lg-mobile": ["Inter"],
            "label-md": ["Inter"],
            "title-md": ["Inter"],
            "display-lg": ["Inter"],
            "code-md": ["Courier Prime"],
            "body-lg": ["Inter"],
            "headline-md": ["Inter"],
            "body-md": ["Inter"]
          },
          "fontSize": {
            "headline-lg": ["32px", { "lineHeight": "40px", "letterSpacing": "-0.01em", "fontWeight": "600" }],
            "headline-lg-mobile": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
            "label-md": ["12px", { "lineHeight": "16px", "letterSpacing": "0.01em", "fontWeight": "500" }],
            "title-md": ["18px", { "lineHeight": "24px", "fontWeight": "500" }],
            "display-lg": ["48px", { "lineHeight": "56px", "letterSpacing": "-0.02em", "fontWeight": "700" }],
            "code-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }],
            "body-lg": ["16px", { "lineHeight": "24px", "fontWeight": "400" }],
            "headline-md": ["24px", { "lineHeight": "32px", "fontWeight": "600" }],
            "body-md": ["14px", { "lineHeight": "20px", "fontWeight": "400" }]
          }
        }
      }
    }
  </script>
</head>
<body class="bg-surface font-body-md text-body-md text-on-surface antialiased">

  <!-- Mobile Sidebar Overlay -->
  <div id="sidebarOverlay" onclick="toggleSidebar()" class="fixed inset-0 bg-black/40 z-40 hidden lg:hidden transition-opacity"></div>

  <!-- Sidebar Navigation -->
  <aside id="mainSidebar" class="fixed left-0 top-0 h-screen w-64 bg-surface-container-lowest border-r border-outline-variant/40 z-50 flex flex-col justify-between select-none -translate-x-full lg:translate-x-0 transition-transform duration-300 ease-in-out">
    <div class="flex flex-col">
      <div class="h-16 flex items-center justify-between px-lg border-b border-outline-variant/30">
        <div class="flex items-center gap-sm">
          <div class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary-fixed text-primary-container">
            <span class="material-symbols-outlined text-[20px]">receipt_long</span>
          </div>
          <div class="flex flex-col">
            <span class="font-headline-md text-headline-md text-on-surface tracking-tight leading-none text-[18px]">Papertrail</span>
            <span class="font-label-md text-label-md text-on-surface-variant leading-tight">e-receipts</span>
          </div>
        </div>
        <button onclick="toggleSidebar()" class="lg:hidden p-1 rounded-lg text-on-surface-variant hover:bg-surface-container">
          <span class="material-symbols-outlined text-[20px]">close</span>
        </button>
      </div>
      <nav class="flex flex-col gap-xs px-md pt-lg" data-active-classes="bg-primary-container text-on-primary font-title-md font-medium rounded-xl shadow-sm">
        <a class="flex items-center gap-md px-md py-sm rounded-xl font-body-md text-body-md text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors" data-path="dashboard" href="#">
          <span class="material-symbols-outlined text-[20px]">dashboard</span>
          <span>Dashboard</span>
        </a>
        <a class="flex items-center gap-md px-md py-sm rounded-xl font-body-md text-body-md text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors" data-path="receipts" href="#">
          <span class="material-symbols-outlined text-[20px]">receipt</span>
          <span>Receipts</span>
        </a>
        <a aria-current="page" class="flex items-center gap-md px-md py-sm transition-colors bg-primary-container text-on-primary font-title-md font-medium rounded-xl shadow-sm" data-path="customers" href="#">
          <span class="material-symbols-outlined text-[20px]">group</span>
          <span>Customers</span>
        </a>
        <a class="flex items-center gap-md px-md py-sm rounded-xl font-body-md text-body-md text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors" data-path="templates" href="#">
          <span class="material-symbols-outlined text-[20px]">style</span>
          <span>Templates</span>
        </a>
        <a class="flex items-center gap-md px-md py-sm rounded-xl font-body-md text-body-md text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors" data-path="settings" href="#">
          <span class="material-symbols-outlined text-[20px]">settings</span>
          <span>Settings</span>
        </a>
      </nav>
    </div>
    <div class="p-md border-t border-outline-variant/30">
      <div class="flex items-center justify-between p-sm rounded-xl hover:bg-surface-container transition-colors">
        <div class="flex items-center gap-sm">
          <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
          </div>
          <div class="flex flex-col truncate">
            <span class="font-title-md text-title-md text-[14px] text-on-surface font-medium truncate">Louis</span>
            <span class="font-label-md text-label-md text-on-surface-variant truncate">louis@business.co</span>
          </div>
        </div>
        <a class="text-on-surface-variant hover:text-error p-xs rounded-lg transition-colors flex items-center" data-path="login" href="#" title="Logout / Account">
          <span class="material-symbols-outlined text-[20px]">logout</span>
        </a>
      </div>
    </div>
  </aside>

  <!-- Main View Container -->
  <div class="lg:pl-64 transition-all">
    <!-- Top Header -->
    <header class="fixed top-0 left-0 lg:left-64 right-0 h-16 bg-surface-container-lowest/90 backdrop-blur-md border-b border-outline-variant/30 z-40 px-md lg:px-lg flex items-center justify-between gap-md">
      <div class="flex items-center gap-sm flex-1 max-w-xs md:max-w-md">
        <button onclick="toggleSidebar()" class="lg:hidden p-2 rounded-xl text-on-surface-variant hover:bg-surface-container" title="Open Menu">
          <span class="material-symbols-outlined text-[22px]">menu</span>
        </button>
        <div class="relative w-full">
          <span class="material-symbols-outlined absolute left-sm top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
          <input class="w-full h-10 pl-9 pr-md bg-surface-container-low rounded-xl border border-outline-variant/50 font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant/70 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-container/20 transition-all" placeholder="Search receipts, customers..." type="text"/>
        </div>
      </div>
      <div class="flex items-center gap-xs sm:gap-md">
        <button class="inline-flex items-center gap-xs px-sm sm:px-md py-sm rounded-xl bg-primary-container hover:bg-primary text-on-primary font-title-md text-title-md text-[13px] sm:text-[14px] font-medium shadow-sm transition-colors" type="button">
          <span class="material-symbols-outlined text-[18px]">add</span>
          <span class="hidden sm:inline">Create Receipt</span>
        </button>
        <div class="h-6 w-px bg-outline-variant/40 mx-xs hidden sm:block"></div>
        <button aria-label="Notifications" class="p-sm rounded-xl text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors" type="button">
          <span class="material-symbols-outlined text-[20px]">notifications</span>
        </button>
        <button aria-label="Help &amp; Docs" class="p-sm rounded-xl text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors hidden sm:block" type="button">
          <span class="material-symbols-outlined text-[20px]">help_outline</span>
        </button>
        <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center cursor-pointer ml-xs flex-shrink-0">
          <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
        </div>
      </div>
    </header>

    <!-- Main Content Body -->
    <main class="w-full pt-16 bg-surface px-md sm:px-lg py-md sm:py-xl min-h-screen">
      <div class="flex flex-col w-full">
        <div class="max-w-[1400px] w-full mx-auto space-y-6">
          
          <!-- Header Title & Master Control Bar -->
          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
            <div>
              <div class="flex items-center gap-2">
                <span class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Customers</span>
                <span class="px-2.5 py-0.5 rounded-full text-label-md font-label-md bg-secondary-container text-on-secondary-fixed-variant font-medium">Directory</span>
              </div>
              <p class="font-body-md text-body-md text-on-surface-variant mt-1">Manage your client contacts, transaction history, and contact details.</p>
            </div>
            <div class="flex flex-wrap sm:flex-nowrap items-center gap-2.5 sm:gap-3">
              <div class="relative w-full sm:w-auto flex-1 sm:flex-none">
                <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-outline text-[18px]">search</span>
                <input class="h-10 pl-9 pr-4 w-full sm:w-64 md:w-72 bg-surface-container-lowest rounded-lg border border-outline-variant/60 font-body-md text-body-md text-on-surface placeholder:text-outline focus:outline-none focus:border-primary-container focus:ring-2 focus:ring-primary-container/20 transition-all shadow-sm" placeholder="Search customers..." type="text"/>
              </div>
              <div class="relative">
                <button class="h-10 px-3.5 bg-surface-container-lowest border border-outline-variant/60 rounded-lg text-on-surface hover:bg-surface-container-low transition-colors font-label-md text-label-md flex items-center gap-2 shadow-sm" id="filterDropdownBtn" type="button">
                  <span class="material-symbols-outlined text-[18px] text-secondary">tune</span>
                  <span>Filter</span>
                  <span class="material-symbols-outlined text-[16px] text-outline">expand_more</span>
                </button>
              </div>
              <button class="h-10 px-4 bg-primary-container hover:bg-primary text-on-primary rounded-lg font-title-md text-title-md text-[14px] font-medium inline-flex items-center gap-1.5 shadow-sm transition-all hover:shadow ml-auto sm:ml-0" type="button">
                <span class="material-symbols-outlined text-[18px]">add</span>
                <span class="whitespace-nowrap">Add Customer</span>
              </button>
            </div>
          </div>

          <!-- Summary Metric Counters Row -->
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4 sm:gap-5">
            <!-- Metric 1 -->
            <div class="p-5 rounded-xl bg-surface-container-lowest border border-outline-variant/40 shadow-sm relative overflow-hidden flex flex-col justify-between">
              <div class="flex items-start justify-between">
                <div class="flex flex-col">
                  <span class="font-label-md text-label-md text-secondary tracking-wide uppercase font-medium">Total Customers</span>
                  <span class="font-display-lg text-display-lg text-on-surface mt-1 tracking-tight">28</span>
                </div>
                <div class="w-10 h-10 rounded-lg bg-secondary-fixed flex items-center justify-center text-primary">
                  <span class="material-symbols-outlined text-[22px]">group</span>
                </div>
              </div>
              <div class="flex items-center gap-1.5 mt-3 pt-3 border-t border-outline-variant/20 font-label-md text-label-md text-on-surface-variant">
                <span class="inline-flex items-center text-[#15803d] font-semibold bg-[#dcfce7] px-1.5 py-0.5 rounded">
                  <span class="material-symbols-outlined text-[14px]">arrow_upward</span>4
                </span>
                <span class="text-secondary font-body-md text-body-md text-[13px]">registered this month</span>
              </div>
            </div>
            <!-- Metric 2 -->
            <div class="p-5 rounded-xl bg-surface-container-lowest border border-outline-variant/40 shadow-sm relative overflow-hidden flex flex-col justify-between">
              <div class="flex items-start justify-between">
                <div class="flex flex-col">
                  <span class="font-label-md text-label-md text-secondary tracking-wide uppercase font-medium">Active Customers</span>
                  <span class="font-display-lg text-display-lg text-on-surface mt-1 tracking-tight">24</span>
                </div>
                <div class="w-10 h-10 rounded-lg bg-[#e0f2fe] flex items-center justify-center text-[#0284c7]">
                  <span class="material-symbols-outlined text-[22px]">shopping_cart_checkout</span>
                </div>
              </div>
              <div class="flex items-center gap-1.5 mt-3 pt-3 border-t border-outline-variant/20 font-label-md text-label-md text-on-surface-variant">
                <span class="w-2 h-2 rounded-full bg-[#16a34a]"></span>
                <span class="text-secondary font-body-md text-body-md text-[13px]">Purchased within last 30 days</span>
              </div>
            </div>
            <!-- Metric 3 -->
            <div class="p-5 rounded-xl bg-surface-container-lowest border border-outline-variant/40 shadow-sm relative overflow-hidden flex flex-col justify-between sm:col-span-2 md:col-span-1">
              <div class="flex items-start justify-between">
                <div class="flex flex-col">
                  <span class="font-label-md text-label-md text-secondary tracking-wide uppercase font-medium">Avg. Revenue / Customer</span>
                  <span class="font-display-lg text-display-lg text-on-surface mt-1 tracking-tight">₦8,750</span>
                </div>
                <div class="w-10 h-10 rounded-lg bg-primary-fixed flex items-center justify-center text-primary-container">
                  <span class="material-symbols-outlined text-[22px]">payments</span>
                </div>
              </div>
              <div class="flex items-center gap-1.5 mt-3 pt-3 border-t border-outline-variant/20 font-label-md text-label-md text-on-surface-variant">
                <span class="inline-flex items-center text-[#15803d] font-semibold bg-[#dcfce7] px-1.5 py-0.5 rounded">
                  <span class="material-symbols-outlined text-[14px]">trending_up</span>+12.4%
                </span>
                <span class="text-secondary font-body-md text-body-md text-[13px]">vs previous cycle</span>
              </div>
            </div>
          </div>

          <!-- Main Workspace: Table + Interactive Customer Profile Pane -->
          <div class="grid grid-cols-1 xl:grid-cols-12 gap-6 items-start">
            
            <!-- Customer Directory List Table -->
            <div class="xl:col-span-8 bg-surface-container-lowest rounded-xl border border-outline-variant/40 shadow-sm overflow-hidden flex flex-col">
              <div class="px-5 py-4 border-b border-outline-variant/30 flex items-center justify-between bg-surface-container-low/40">
                <div class="flex items-center gap-3">
                  <span class="font-title-md text-title-md text-on-surface font-semibold">Customer Records</span>
                  <span class="px-2 py-0.5 rounded bg-surface-container text-secondary text-label-md font-label-md">28 total</span>
                </div>
                <div class="flex items-center gap-2">
                  <button class="p-1.5 rounded text-secondary hover:bg-surface-container transition-colors" title="Export List">
                    <span class="material-symbols-outlined text-[20px]">download</span>
                  </button>
                  <button class="p-1.5 rounded text-secondary hover:bg-surface-container transition-colors" title="Table View Settings">
                    <span class="material-symbols-outlined text-[20px]">view_column</span>
                  </button>
                </div>
              </div>
              <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse min-w-[640px]">
                  <thead>
                    <tr class="bg-surface-container-low/70 border-b border-outline-variant/30 text-secondary uppercase font-label-md text-label-md tracking-wider">
                      <th class="py-3 px-4 font-semibold">Customer</th>
                      <th class="py-3 px-4 font-semibold">Contact Info</th>
                      <th class="py-3 px-4 font-semibold text-center">Receipts</th>
                      <th class="py-3 px-4 font-semibold text-right">Total Spent</th>
                      <th class="py-3 px-4 font-semibold">Last Activity</th>
                      <th class="py-3 px-4 text-center font-semibold">Actions</th>
                    </tr>
                  </thead>
                  <tbody class="font-body-md text-body-md text-on-surface divide-y divide-outline-variant/20" id="customersTableBody">
                    <!-- Row 1: John Doe -->
                    <tr class="hover:bg-surface-container-low/60 cursor-pointer transition-colors bg-primary-fixed/20 border-l-4 border-l-primary-container" onclick="selectCustomer('John Doe', 'JD', '08012345678', 'john@example.com', '12 receipts', '₦327,000', 'Active VIP Client')">
                      <td class="py-3.5 px-4">
                        <div class="flex items-center gap-3">
                          <div class="w-9 h-9 rounded-full bg-primary text-on-primary font-title-md text-title-md text-[13px] flex items-center justify-center font-semibold shadow-xs">
                            JD
                          </div>
                          <div class="flex flex-col">
                            <span class="font-title-md text-title-md text-[14px] font-semibold text-on-surface">John Doe</span>
                            <span class="text-secondary text-[12px]">Lagos, Nigeria</span>
                          </div>
                        </div>
                      </td>
                      <td class="py-3.5 px-4 font-code-md text-code-md text-[13px]">
                        <div class="flex flex-col">
                          <span class="text-on-surface">08012345678</span>
                          <span class="text-secondary font-body-md text-body-md text-[12px]">john@example.com</span>
                        </div>
                      </td>
                      <td class="py-3.5 px-4 text-center">
                        <span class="px-2.5 py-1 rounded-full bg-surface-container text-on-surface font-medium text-[12px]">12 receipts</span>
                      </td>
                      <td class="py-3.5 px-4 text-right font-semibold text-on-surface font-code-md text-[13px]">
                        ₦327,000
                      </td>
                      <td class="py-3.5 px-4">
                        <div class="flex items-center gap-1.5">
                          <span class="w-1.5 h-1.5 rounded-full bg-[#16a34a]"></span>
                          <span class="text-on-surface font-medium">Today</span>
                        </div>
                      </td>
                      <td class="py-3.5 px-4">
                        <div class="flex items-center justify-center gap-1">
                          <a class="p-1.5 rounded-lg text-[#15803d] hover:bg-[#dcfce7] transition-colors" href="https://wa.me/2348012345678" onclick="event.stopPropagation()" target="_blank" title="Chat on WhatsApp">
                            <span class="material-symbols-outlined text-[18px]">chat</span>
                          </a>
                          <button class="p-1.5 rounded-lg text-primary-container hover:bg-primary-fixed transition-colors" onclick="event.stopPropagation()" title="New Receipt" type="button">
                            <span class="material-symbols-outlined text-[18px]">receipt_long</span>
                          </button>
                          <button class="p-1.5 rounded-lg text-secondary hover:bg-surface-container transition-colors" onclick="event.stopPropagation()" title="Options" type="button">
                            <span class="material-symbols-outlined text-[18px]">more_vert</span>
                          </button>
                        </div>
                      </td>
                    </tr>
                    <!-- Row 2: Mary Jane -->
                    <tr class="hover:bg-surface-container-low/60 cursor-pointer transition-colors" onclick="selectCustomer('Mary Jane', 'MJ', '08123456789', 'mary@example.com', '7 receipts', '₦87,500', 'Frequent Buyer')">
                      <td class="py-3.5 px-4">
                        <div class="flex items-center gap-3">
                          <div class="w-9 h-9 rounded-full bg-[#7c3aed] text-on-primary font-title-md text-title-md text-[13px] flex items-center justify-center font-semibold shadow-xs">
                            MJ
                          </div>
                          <div class="flex flex-col">
                            <span class="font-title-md text-title-md text-[14px] font-semibold text-on-surface">Mary Jane</span>
                            <span class="text-secondary text-[12px]">Abuja, FCT</span>
                          </div>
                        </div>
                      </td>
                      <td class="py-3.5 px-4 font-code-md text-code-md text-[13px]">
                        <div class="flex flex-col">
                          <span class="text-on-surface">08123456789</span>
                          <span class="text-secondary font-body-md text-body-md text-[12px]">mary@example.com</span>
                        </div>
                      </td>
                      <td class="py-3.5 px-4 text-center">
