<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>
        Receipt <%= receipt.receiptNumber %>
    </title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            padding: 40px 20px;
            background: #f5f7fa;
            font-family: Arial, sans-serif;
            color: #222;
        }

        .receipt {
            width: 100%;
            max-width: 800px;
            margin: 0 auto;
            background: #ffffff;
            padding: 40px;
            border-radius: 12px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        }

        .header {
            display: flex;
            justify-content: space-between;
            gap: 30px;
            padding-bottom: 25px;
            border-bottom: 3px solid <%= settings.primaryColor || "#004AAD" %>;
        }

        .company-name {
            font-size: 28px;
            font-weight: 700;
            color: <%= settings.primaryColor || "#004AAD" %>;
            margin-bottom: 10px;
        }

        .company-details {
            color: #666;
            line-height: 1.6;
            font-size: 14px;
        }

        .receipt-title {
            text-align: right;
        }

        .receipt-title h1 {
            margin: 0;
            font-size: 32px;
            color: <%= settings.primaryColor || "#004AAD" %>;
        }

        .receipt-number {
            margin-top: 8px;
            color: #666;
            font-size: 14px;
        }

        .section {
            margin-top: 30px;
        }

        .section-title {
            font-size: 13px;
            font-weight: 700;
            color: #777;
            text-transform: uppercase;
            letter-spacing: 1px;
            margin-bottom: 10px;
        }

        .customer {
            line-height: 1.6;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        th {
            text-align: left;
            padding: 12px 8px;
            background: <%= settings.primaryColor || "#004AAD" %>;
            color: white;
            font-size: 13px;
        }

        td {
            padding: 14px 8px;
            border-bottom: 1px solid #eee;
            font-size: 14px;
        }

        .right {
            text-align: right;
        }

        .summary {
            width: 320px;
            margin-left: auto;
            margin-top: 25px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            color: #555;
        }

        .total {
            margin-top: 10px;
            padding-top: 15px;
            border-top: 2px solid #ddd;
            font-size: 20px;
            font-weight: 700;
            color: <%= settings.primaryColor || "#004AAD" %>;
        }

        .payment {
            display: inline-block;
            margin-top: 15px;
            padding: 7px 14px;
            border-radius: 20px;
            background: #e8f5e9;
            color: #2e7d32;
            font-size: 12px;
            font-weight: 700;
        }

        .footer {
            margin-top: 40px;
            padding-top: 20px;
            border-top: 1px solid #eee;
            text-align: center;
            color: #777;
            font-size: 14px;
        }

        @media (max-width: 600px) {
            body {
                padding: 10px;
            }

            .receipt {
                padding: 20px;
            }

            .header {
                flex-direction: column;
            }

            .receipt-title {
                text-align: left;
            }

            .summary {
                width: 100%;
            }

            table {
                font-size: 12px;
            }
        }

        @media print {
            body {
                padding: 0;
                background: white;
            }

            .receipt {
                max-width: none;
                box-shadow: none;
                border-radius: 0;
            }
        }
    </style>
</head>

<body>

<div class="receipt">

    <!-- HEADER -->
    <div class="header">

        <div>

            <% if (settings.showLogo && company.logoUrl) { %>

                <img
                    src="<%= company.logoUrl %>"
                    alt="<%= company.name %>"
                    style="max-width: 180px; max-height: 70px; margin-bottom: 10px;"
                >

            <% } %>

            <div class="company-name">
                <%= company.name %>
            </div>

            <div class="company-details">

                <% if (settings.showAddress && company.address) { %>
                    <div><%= company.address %></div>
                <% } %>

                <% if (settings.showPhone && company.phone) { %>
                    <div><%= company.phone %></div>
                <% } %>

                <% if (company.email) { %>
                    <div><%= company.email %></div>
                <% } %>

                <% if (settings.showWebsite && company.website) { %>
                    <div><%= company.website %></div>
                <% } %>

            </div>

        </div>

        <div class="receipt-title">

            <h1>RECEIPT</h1>

            <div class="receipt-number">
                <strong>#<%= receipt.receiptNumber %></strong>
            </div>

            <div class="receipt-number">
                <%= new Date(receipt.createdAt).toLocaleDateString() %>
            </div>

        </div>

    </div>


    <!-- CUSTOMER -->
    <div class="section">

        <div class="section-title">
            Bill To
        </div>

        <% if (customer) { %>

            <div class="customer">

                <strong>
                    <%= customer.name %>
                </strong>

                <% if (customer.email) { %>
                    <div><%= customer.email %></div>
                <% } %>

                <% if (customer.phone) { %>
                    <div><%= customer.phone %></div>
                <% } %>

            </div>

        <% } else { %>

            <div class="customer">
                Walk-in Customer
            </div>

        <% } %>

    </div>


    <!-- ITEMS -->
    <div class="section">

        <div class="section-title">
            Items
        </div>

        <table>

            <thead>
                <tr>
                    <th>Item</th>
                    <th>Qty</th>
                    <th class="right">Unit Price</th>
                    <th class="right">Total</th>
                </tr>
            </thead>

            <tbody>

                <% items.forEach(item => { %>

                    <tr>

                        <td>
                            <%= item.name %>
                        </td>

                        <td>
                            <%= item.quantity %>
                        </td>

                        <td class="right">
                            <%= company.currency %>
                            <%= Number(item.unitPrice).toLocaleString() %>
                        </td>

                        <td class="right">
                            <%= company.currency %>
                            <%= Number(item.total).toLocaleString() %>
                        </td>

                    </tr>

                <% }) %>

            </tbody>

        </table>

    </div>


    <!-- SUMMARY -->
    <div class="summary">

        <div class="summary-row">
            <span>Subtotal</span>
            <span>
                <%= company.currency %>
                <%= Number(receipt.subtotal).toLocaleString() %>
            </span>
        </div>

        <div class="summary-row">
            <span>Discount</span>
            <span>
                <%= company.currency %>
                <%= Number(receipt.discount).toLocaleString() %>
            </span>
        </div>

        <div class="summary-row">
            <span>Tax</span>
            <span>
                <%= company.currency %>
                <%= Number(receipt.tax).toLocaleString() %>
            </span>
        </div>

        <div class="summary-row total">
            <span>Total</span>
            <span>
                <%= company.currency %>
                <%= Number(receipt.total).toLocaleString() %>
            </span>
        </div>

    </div>


    <!-- PAYMENT -->
    <div class="section">

        <div class="section-title">
            Payment
        </div>

        <div>
            Method:
            <strong>
                <%= receipt.paymentMethod %>
            </strong>
        </div>

        <div class="payment">
            <%= receipt.paymentStatus %>
        </div>

    </div>


    <!-- NOTES -->
    <% if (receipt.notes) { %>

        <div class="section">

            <div class="section-title">
                Notes
            </div>

            <div>
                <%= receipt.notes %>
            </div>

        </div>

    <% } %>


    <!-- FOOTER -->
    <div class="footer">

        <%= settings.footerText || "Thank you for your business!" %>

    </div>

</div>

</body>
</html>