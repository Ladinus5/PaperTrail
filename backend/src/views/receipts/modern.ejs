<%
  // Merge defaults with the template's settings
  const defaults = {
    primaryColor: "#004aad",
    accentColor: "#f3f3fc",
    textColor: "#191b22",
    mutedColor: "#585f6c",
    borderColor: "#c3c6d5",
    logoUrl: null,
    companyDisplayName: null,
    showLogo: true,
    showQR: true,
    headerStyle: "bar",
    fontFamily: "Inter",
    footerText: "Thank you for your business",
    watermarkText: null,
    showTaxBreakdown: true,
    showPaymentMethod: true,
  };

  const s = { ...defaults, ...(settings || {}) };

  const symbolMap = { NGN: "₦", USD: "$", GBP: "£", GHS: "₵" };
  const sym = symbolMap[company.currency] || "₦";

  const fmt = (n) => sym + Number(n || 0).toLocaleString("en-NG", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  });

  const dateStr = new Date(receipt.createdAt).toLocaleString("en-NG", {
    year: "numeric", month: "short", day: "numeric",
    hour: "2-digit", minute: "2-digit",
  });

  const displayName = s.companyDisplayName || company.name;
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>Receipt <%= receipt.receiptNumber %></title>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Courier+Prime&family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet"/>
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    :root {
      --primary: <%= s.primaryColor %>;
      --accent: <%= s.accentColor %>;
      --text: <%= s.textColor %>;
      --muted: <%= s.mutedColor %>;
      --border: <%= s.borderColor %>;
      --font-family: <%= s.fontFamily %>, Inter, sans-serif;
    }
    * { box-sizing: border-box; }
    body {
      font-family: var(--font-family);
      color: var(--text);
      background: #ffffff;
      margin: 0;
      padding: 40px 32px;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .receipt-container { max-width: 720px; margin: 0 auto; position: relative; }
    .header-bar { height: 8px; background: var(--primary); border-radius: 999px; }
    .primary-text { color: var(--primary); }
    .primary-bg { background: var(--primary); color: #fff; }
    .accent-bg { background: var(--accent); }
    .muted-text { color: var(--muted); }
    .border-line { border-color: var(--border); }
    .total-row { border-top: 2px solid var(--primary); }
    .watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-30deg);
      font-size: 120px;
      font-weight: 900;
      color: var(--primary);
      opacity: 0.06;
      pointer-events: none;
      white-space: nowrap;
      z-index: 0;
    }
    .content { position: relative; z-index: 1; }
  </style>
</head>
<body>
  <div class="receipt-container">
    <% if (s.watermarkText) { %>
      <div class="watermark"><%= s.watermarkText %></div>
    <% } %>

    <div class="content">
      <% if (s.headerStyle === "bar") { %>
        <div class="header-bar mb-6"></div>
      <% } %>

      <!-- Header -->
      <div class="flex justify-between items-start mb-8">
        <div class="flex items-start gap-4">
          <% if (s.showLogo && s.logoUrl) { %>
            <img src="<%= s.logoUrl %>" alt="Logo" style="height:56px;width:auto;object-fit:contain;"/>
          <% } else if (s.showLogo) { %>
            <div class="w-12 h-12 rounded-lg primary-bg flex items-center justify-center text-2xl font-bold">
              <%= displayName.charAt(0).toUpperCase() %>
            </div>
          <% } %>
          <div>
            <div class="text-xl font-bold primary-text"><%= displayName %></div>
            <% if (company.address) { %>
              <div class="text-xs muted-text mt-1 leading-relaxed whitespace-pre-line"><%= company.address %></div>
            <% } %>
            <% if (company.email) { %>
              <div class="text-xs muted-text"><%= company.email %></div>
            <% } %>
            <% if (company.phone) { %>
              <div class="text-xs muted-text"><%= company.phone %></div>
            <% } %>
            <% if (company.website) { %>
              <div class="text-xs muted-text"><%= company.website %></div>
            <% } %>
          </div>
        </div>
        <div class="text-right">
          <div class="text-2xl font-black primary-text tracking-tight">RECEIPT</div>
          <div class="text-xs muted-text font-mono mt-1"><%= receipt.receiptNumber %></div>
          <div class="text-xs muted-text mt-0.5"><%= dateStr %></div>
          <div class="inline-block mt-2 px-2 py-0.5 rounded text-[10px] font-bold uppercase tracking-wider
            <%= receipt.paymentStatus === 'PAID' ? 'bg-[#dcfce7] text-[#15803d]' : 'bg-gray-100 text-gray-600' %>">
            <%= receipt.paymentStatus %>
          </div>
        </div>
      </div>

      <!-- Billed To -->
      <div class="grid grid-cols-2 gap-6 mb-8">
        <div>
          <div class="text-[10px] font-bold uppercase tracking-wider muted-text mb-1">Billed To</div>
          <% if (customer) { %>
            <div class="font-semibold text-sm"><%= customer.name %></div>
            <% if (customer.email) { %><div class="text-xs muted-text"><%= customer.email %></div><% } %>
            <% if (customer.phone) { %><div class="text-xs muted-text"><%= customer.phone %></div><% } %>
          <% } else { %>
            <div class="font-semibold text-sm">Walk-in Customer</div>
          <% } %>
        </div>
        <div class="text-right">
          <div class="text-[10px] font-bold uppercase tracking-wider muted-text mb-1">Payment Method</div>
          <% if (s.showPaymentMethod) { %>
            <div class="font-medium text-sm"><%= receipt.paymentMethod %></div>
          <% } %>
        </div>
      </div>

      <!-- Items Table -->
      <table class="w-full text-left border-collapse mb-6">
        <thead>
          <tr class="border-y border-line" style="border-color: var(--border);">
            <th class="py-2 text-[10px] font-bold uppercase tracking-wider muted-text">Description</th>
            <th class="py-2 text-[10px] font-bold uppercase tracking-wider muted-text text-center">Qty</th>
            <th class="py-2 text-[10px] font-bold uppercase tracking-wider muted-text text-right">Unit Price</th>
            <th class="py-2 text-[10px] font-bold uppercase tracking-wider muted-text text-right">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% items.forEach(item => { %>
            <tr class="border-b" style="border-color: var(--border); opacity: 0.6;">
              <td class="py-3 text-sm"><%= item.name %></td>
              <td class="py-3 text-sm text-center muted-text"><%= item.quantity %></td>
              <td class="py-3 text-sm text-right muted-text font-mono"><%= fmt(item.unitPrice) %></td>
              <td class="py-3 text-sm text-right font-semibold font-mono"><%= fmt(item.total) %></td>
            </tr>
          <% }) %>
        </tbody>
      </table>

      <!-- Totals -->
      <div class="flex justify-end mb-8">
        <div class="w-full max-w-xs space-y-2">
          <div class="flex justify-between text-sm muted-text">
            <span>Subtotal</span>
            <span class="font-mono"><%= fmt(receipt.subtotal) %></span>
          </div>
          <% if (Number(receipt.discount) > 0) { %>
            <div class="flex justify-between text-sm muted-text">
              <span>Discount</span>
              <span class="font-mono">-<%= fmt(receipt.discount) %></span>
            </div>
          <% } %>
          <% if (s.showTaxBreakdown && Number(receipt.tax) > 0) { %>
            <div class="flex justify-between text-sm muted-text">
              <span>Tax</span>
              <span class="font-mono"><%= fmt(receipt.tax) %></span>
            </div>
          <% } %>
          <div class="flex justify-between pt-3 total-row text-base font-bold" style="border-color: var(--primary);">
            <span>Total</span>
            <span class="primary-text font-mono"><%= fmt(receipt.total) %></span>
          </div>
        </div>
      </div>

      <% if (receipt.notes) { %>
        <div class="accent-bg p-4 rounded-lg mb-6">
          <div class="text-[10px] font-bold uppercase tracking-wider muted-text mb-1">Notes</div>
          <div class="text-sm"><%= receipt.notes %></div>
        </div>
      <% } %>

      <!-- Footer -->
      <div class="pt-6 border-t text-center" style="border-color: var(--border);">
        <% if (s.footerText) { %>
          <div class="text-xs muted-text mb-3"><%= s.footerText %></div>
        <% } %>
        <% if (s.showQR) { %>
          <div class="inline-block p-2 border rounded" style="border-color: var(--border);">
            <svg viewBox="0 0 100 100" width="80" height="80">
              <rect width="100" height="100" fill="white"/>
              <rect x="5" y="5" width="30" height="30" fill="none" stroke="black" stroke-width="3"/>
              <rect x="12" y="12" width="16" height="16" fill="black"/>
              <rect x="65" y="5" width="30" height="30" fill="none" stroke="black" stroke-width="3"/>
              <rect x="72" y="12" width="16" height="16" fill="black"/>
              <rect x="5" y="65" width="30" height="30" fill="none" stroke="black" stroke-width="3"/>
              <rect x="12" y="72" width="16" height="16" fill="black"/>
              <rect x="45" y="15" width="5" height="5" fill="black"/>
              <rect x="55" y="25" width="5" height="5" fill="black"/>
              <rect x="45" y="45" width="5" height="5" fill="black"/>
              <rect x="65" y="55" width="5" height="5" fill="black"/>
              <rect x="75" y="45" width="5" height="5" fill="black"/>
              <rect x="45" y="65" width="5" height="5" fill="black"/>
              <rect x="65" y="75" width="5" height="5" fill="black"/>
              <rect x="85" y="85" width="5" height="5" fill="black"/>
            </svg>
          </div>
          <div class="text-[10px] muted-text mt-2">Scan to verify</div>
        <% } %>
        <div class="text-[10px] muted-text mt-3">Powered by Papertrail</div>
      </div>
    </div>
  </div>
</body>
</html>