<%
  const defaults = {
    primaryColor: "#0f172a",
    accentColor: "#f9fafb",
    textColor: "#111827",
    mutedColor: "#6b7280",
    borderColor: "#e5e7eb",
    logoUrl: null,
    companyDisplayName: null,
    showLogo: true,
    showQR: true,
    headerStyle: "simple",
    fontFamily: "Inter",
    footerText: "",
    watermarkText: null,
    showTaxBreakdown: true,
    showPaymentMethod: true,
  };
  const s = { ...defaults, ...(settings || {}) };
  const symbolMap = { NGN: "₦", USD: "$", GBP: "£", GHS: "₵" };
  const sym = symbolMap[company.currency] || "₦";
  const fmt = (n) => sym + Number(n || 0).toLocaleString("en-NG", { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  const dateStr = new Date(receipt.createdAt).toLocaleDateString("en-NG", { year: "numeric", month: "short", day: "numeric" });
  const displayName = s.companyDisplayName || company.name;
%>
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8"/>
  <title>Receipt <%= receipt.receiptNumber %></title>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;900&display=swap" rel="stylesheet"/>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: Inter, system-ui, sans-serif;
      color: <%= s.textColor %>;
      background: #ffffff;
      margin: 0;
      padding: 60px 40px;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }
    .container { max-width: 560px; margin: 0 auto; }
    .top-bar { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 6px; }
    .company-name { font-size: 26px; font-weight: 900; letter-spacing: -0.02em; color: <%= s.textColor %>; }
    .receipt-num { font-size: 12px; color: <%= s.mutedColor %>; font-family: 'Courier New', monospace; }
    .subtext { font-size: 13px; color: <%= s.mutedColor %>; margin-bottom: 40px; }
    .section-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: <%= s.mutedColor %>; margin-bottom: 12px; }
    .line-item { display: flex; justify-content: space-between; align-items: baseline; padding: 14px 0; border-bottom: 1px solid <%= s.borderColor %>; }
    .line-item .name { font-size: 15px; color: <%= s.textColor %>; }
    .line-item .price { font-size: 15px; font-weight: 500; color: <%= s.textColor %>; font-family: 'Courier New', monospace; }
    .total-block { margin-top: 32px; padding: 24px; background: <%= s.accentColor %>; border-radius: 12px; }
    .total-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: <%= s.mutedColor %>; }
    .total-value { font-size: 36px; font-weight: 900; color: <%= s.primaryColor %>; letter-spacing: -0.02em; line-height: 1.1; margin-top: 6px; }
    .total-value .cents { font-size: 16px; color: <%= s.mutedColor %>; font-weight: 400; }
    .paid-mark { display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 500; color: #059669; margin-top: 10px; }
    .footer { margin-top: 40px; padding-top: 20px; border-top: 1px solid <%= s.borderColor %>; display: flex; justify-content: space-between; font-size: 11px; color: <%= s.mutedColor %>; }
    .logo { height: 44px; width: auto; object-fit: contain; margin-bottom: 20px; }
    .meta-block { margin-top: 40px; font-size: 12px; color: <%= s.mutedColor %>; line-height: 1.7; }
    .meta-block strong { color: <%= s.textColor %>; font-weight: 600; display: block; font-size: 13px; margin-bottom: 2px; }
  </style>
</head>
<body>
  <div class="container">
    <% if (s.showLogo && s.logoUrl) { %>
      <img src="<%= s.logoUrl %>" alt="Logo" class="logo"/>
    <% } %>

    <div class="top-bar">
      <div class="company-name"><%= displayName %></div>
      <div class="receipt-num">#<%= receipt.receiptNumber.replace(/^[A-Z]+-/, '') %></div>
    </div>
    <div class="subtext">Receipt for <%= customer ? customer.name : 'Walk-in Customer' %></div>

    <div class="section-label">Items</div>
    <% items.forEach(item => { %>
      <div class="line-item">
        <span class="name"><%= item.name %> <% if (item.quantity > 1) { %><span style="color:<%= s.mutedColor %>;">×<%= item.quantity %></span><% } %></span>
        <span class="price"><%= fmt(item.total) %></span>
      </div>
    <% }) %>

    <div class="total-block">
      <div class="total-label">Total Paid</div>
      <div class="total-value">
        <%= fmt(receipt.total).split('.')[0] %><span class="cents">.<%= fmt(receipt.total).split('.')[1] %></span>
      </div>
      <div class="paid-mark">
        <svg width="14" height="14" viewBox="0 0 20 20" fill="currentColor"><path d="M16.7 5.3a1 1 0 010 1.4l-8 8a1 1 0 01-1.4 0l-4-4a1 1 0 011.4-1.4L8 12.6l7.3-7.3a1 1 0 011.4 0z"/></svg>
        <%= receipt.paymentStatus %> via <%= receipt.paymentMethod %>
      </div>
    </div>

    <% if (customer || receipt.notes) { %>
      <div class="meta-block">
        <% if (customer) { %>
          <strong><%= customer.name %></strong>
          <% if (customer.email) { %><div><%= customer.email %></div><% } %>
          <% if (customer.phone) { %><div><%= customer.phone %></div><% } %>
        <% } %>
        <% if (receipt.notes) { %><div style="margin-top:12px;"><%= receipt.notes %></div><% } %>
      </div>
    <% } %>

    <div class="footer">
      <span><%= dateStr %></span>
      <span><%= s.footerText || 'Powered by Papertrail' %></span>
    </div>
  </div>
</body>
</html>