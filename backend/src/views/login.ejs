<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8"/>
  <meta content="width=device-width, initial-scale=1.0" name="viewport"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:opsz,wght,FILL,GRAD@20..48,100..700,0..1,-50..200" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com" rel="preconnect"/>
  <link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
  <link href="https://fonts.googleapis.com/css2?family=Courier+Prime&amp;family=Inter:wght@400;500;600;700&amp;display=swap" rel="stylesheet"/>
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet"/>
  <style>
    @layer base{html,body{margin:0;padding:0;}body{overscroll-behavior:none;}main>:first-child{margin-top:0!important;}main>:last-child{margin-bottom:0!important;}}::-webkit-scrollbar{display:none;}
  </style>
  <script src="https://cdn.tailwindcss.com"></script>
  <script id="tailwind-config">
    tailwind.config = {"darkMode":"class","theme":{"extend":{"colors":{"surface-variant":"#e2e2eb","secondary-container":"#dce2f3","on-primary-fixed-variant":"#00429b","surface-bright":"#faf8ff","on-tertiary-fixed-variant":"#7f2b00","tertiary-fixed-dim":"#ffb599","on-primary":"#ffffff","on-background":"#191b22","outline-variant":"#c3c6d5","surface-container-lowest":"#ffffff","primary-fixed":"#d9e2ff","secondary-fixed-dim":"#c0c7d6","tertiary":"#682200","tertiary-fixed":"#ffdbce","on-error-container":"#93000a","on-tertiary":"#ffffff","background":"#faf8ff","on-tertiary-container":"#ffaf90","on-primary-fixed":"#001945","tertiary-container":"#8e3100","on-primary-container":"#a9c1ff","inverse-surface":"#2e3037","on-secondary":"#ffffff","surface-container-highest":"#e2e2eb","on-surface":"#191b22","inverse-on-surface":"#f0f0f9","on-secondary-fixed":"#151c27","surface-tint":"#215abd","error-container":"#ffdad6","surface":"#faf8ff","secondary-fixed":"#dce2f3","surface-container":"#ededf6","surface-container-high":"#e7e7f0","inverse-primary":"#b0c6ff","on-tertiary-fixed":"#370e00","primary-container":"#004aad","primary-fixed-dim":"#b0c6ff","on-secondary-fixed-variant":"#404754","surface-dim":"#d9d9e2","secondary":"#585f6c","outline":"#737784","on-secondary-container":"#5e6572","on-error":"#ffffff","surface-container-low":"#f3f3fc","primary":"#00357f","on-surface-variant":"#434653","error":"#ba1a1a"},"borderRadius":{"DEFAULT":"0.125rem","lg":"0.25rem","xl":"0.5rem","full":"0.75rem"},"spacing":{"margin-desktop":"40px","lg":"24px","gutter":"24px","2xl":"48px","xl":"32px","md":"16px","margin-mobile":"16px","sm":"8px","xs":"4px","base":"4px"},"fontFamily":{"headline-lg":["Inter"],"headline-lg-mobile":["Inter"],"label-md":["Inter"],"title-md":["Inter"],"display-lg":["Inter"],"code-md":["Courier Prime"],"body-lg":["Inter"],"headline-md":["Inter"],"body-md":["Inter"]},"fontSize":{"headline-lg":["32px",{"lineHeight":"40px","letterSpacing":"-0.01em","fontWeight":"600"}],"headline-lg-mobile":["24px",{"lineHeight":"32px","fontWeight":"600"}],"label-md":["12px",{"lineHeight":"16px","letterSpacing":"0.01em","fontWeight":"500"}],"title-md":["18px",{"lineHeight":"24px","fontWeight":"500"}],"display-lg":["48px",{"lineHeight":"56px","letterSpacing":"-0.02em","fontWeight":"700"}],"code-md":["14px",{"lineHeight":"20px","fontWeight":"400"}],"body-lg":["16px",{"lineHeight":"24px","fontWeight":"400"}],"headline-md":["24px",{"lineHeight":"32px","fontWeight":"600"}],"body-md":["14px",{"lineHeight":"20px","fontWeight":"400"}]}}}}
  </script>
</head>
<body class="bg-surface font-body-md text-body-md text-on-surface antialiased">

  <!-- Responsive Sidebar -->
  <aside class="hidden md:flex fixed left-0 top-0 h-screen w-64 bg-surface-container-lowest border-r border-outline-variant/40 z-50 flex-col justify-between select-none">
    <div class="flex flex-col">
      <div class="h-16 flex items-center gap-sm px-lg border-b border-outline-variant/30">
        <div class="flex items-center justify-center w-8 h-8 rounded-xl bg-primary-fixed text-primary-container">
          <span class="material-symbols-outlined text-[20px]">receipt_long</span>
        </div>
        <div class="flex flex-col">
          <span class="font-headline-md text-headline-md text-on-surface tracking-tight leading-none text-[18px]">Papertrail</span>
          <span class="font-label-md text-label-md text-on-surface-variant leading-tight">e-receipts</span>
        </div>
      </div>
      <nav class="flex flex-col gap-xs px-md pt-lg" data-active-classes="bg-primary-container text-on-primary font-title-md font-medium rounded-xl shadow-sm">
        <a class="flex items-center gap-md px-md py-sm rounded-xl font-body-md text-body-md text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors" data-path="dashboard" href="#"><span class="material-symbols-outlined text-[20px]">dashboard</span><span>Dashboard</span></a>
        <a class="flex items-center gap-md px-md py-sm rounded-xl font-body-md text-body-md text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors" data-path="receipts" href="#"><span class="material-symbols-outlined text-[20px]">receipt</span><span>Receipts</span></a>
        <a class="flex items-center gap-md px-md py-sm rounded-xl font-body-md text-body-md text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors" data-path="customers" href="#"><span class="material-symbols-outlined text-[20px]">group</span><span>Customers</span></a>
        <a aria-current="page" class="flex items-center gap-md px-md py-sm transition-colors bg-primary-container text-on-primary font-title-md font-medium rounded-xl shadow-sm" data-path="templates" href="#"><span class="material-symbols-outlined text-[20px]">style</span><span>Templates</span></a>
        <a class="flex items-center gap-md px-md py-sm rounded-xl font-body-md text-body-md text-on-surface-variant hover:bg-surface-container-high hover:text-on-surface transition-colors" data-path="settings" href="#"><span class="material-symbols-outlined text-[20px]">settings</span><span>Settings</span></a>
      </nav>
    </div>
    <div class="p-md border-t border-outline-variant/30">
      <div class="flex items-center justify-between p-sm rounded-xl hover:bg-surface-container transition-colors">
        <div class="flex items-center gap-sm">
          <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center flex-shrink-0">
            <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
          </div>
          <div class="flex flex-col truncate">
            <span class="font-title-md text-title-md text-[14px] text-on-surface font-medium truncate">Louis</span>
            <span class="font-label-md text-label-md text-on-surface-variant truncate">louis@business.co</span>
          </div>
        </div>
        <a class="text-on-surface-variant hover:text-error p-xs rounded-lg transition-colors flex items-center" data-path="login" href="#" title="Logout / Account"><span class="material-symbols-outlined text-[20px]">logout</span></a>
      </div>
    </div>
  </aside>

  <!-- Main Content Wrapper -->
  <div class="pl-0 md:pl-64 min-h-screen flex flex-col">
    <!-- Responsive Header -->
    <header class="fixed top-0 left-0 md:left-64 right-0 h-16 bg-surface-container-lowest/90 backdrop-blur-md border-b border-outline-variant/30 z-40 px-md md:px-lg flex items-center justify-between">
      <div class="flex items-center w-full max-w-xs md:w-80">
        <div class="relative w-full">
          <span class="material-symbols-outlined absolute left-sm top-1/2 -translate-y-1/2 text-on-surface-variant text-[18px]">search</span>
          <input class="w-full h-10 pl-9 pr-md bg-surface-container-low rounded-xl border border-outline-variant/50 font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant/70 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-container/20 transition-all" placeholder="Search receipts, customers, IDs..." type="text"/>
        </div>
      </div>
      <div class="flex items-center gap-xs sm:gap-md">
        <button class="inline-flex items-center gap-xs px-sm md:px-md py-sm rounded-xl bg-primary-container hover:bg-primary text-on-primary font-title-md text-title-md text-[13px] md:text-[14px] font-medium shadow-sm transition-colors" type="button">
          <span class="material-symbols-outlined text-[18px]">add</span>
          <span class="hidden sm:inline">Create Receipt</span>
        </button>
        <div class="h-6 w-px bg-outline-variant/40 mx-xs hidden sm:block"></div>
        <button aria-label="Notifications" class="p-sm rounded-xl text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors hidden sm:block" type="button">
          <span class="material-symbols-outlined text-[20px]">notifications</span>
        </button>
        <button aria-label="Help &amp; Docs" class="p-sm rounded-xl text-on-surface-variant hover:bg-surface-container hover:text-on-surface transition-colors hidden sm:block" type="button">
          <span class="material-symbols-outlined text-[20px]">help_outline</span>
        </button>
        <div class="w-8 h-8 rounded-full bg-primary flex items-center justify-center cursor-pointer ml-xs">
          <span class="material-symbols-outlined text-on-primary text-[18px]">person</span>
        </div>
      </div>
    </header>

    <main class="w-full pt-16 bg-surface px-md md:px-lg py-xl min-h-screen">
      <div class="flex flex-col w-full">
        <div class="relative w-full min-h-[calc(100vh-8rem)] flex items-center justify-center p-xs sm:p-md overflow-hidden">
          <!-- Ambient Micro Background Elements -->
          <div class="absolute inset-0 pointer-events-none opacity-40">
            <svg class="w-full h-full" xmlns="http://www.w3.org/2000/svg">
              <defs>
                <pattern height="24" id="dot-pattern" patternunits="userSpaceOnUse" width="24">
                  <circle class="fill-outline-variant/60" cx="2" cy="2" r="1"></circle>
                </pattern>
              </defs>
              <rect fill="url(#dot-pattern)" height="100%" width="100%"></rect>
            </svg>
          </div>
          <!-- Soft Tonal Radial Glows -->
          <div class="absolute -top-24 -left-20 w-96 h-96 rounded-full bg-primary-fixed/30 blur-3xl pointer-events-none"></div>
          <div class="absolute -bottom-24 -right-20 w-96 h-96 rounded-full bg-secondary-container/40 blur-3xl pointer-events-none"></div>
          
          <div class="relative w-full max-w-[440px] z-10">
            <!-- Upper Context Bar (Monospace Meta) -->
            <div class="flex items-center justify-between px-xs mb-md">
              <div class="flex items-center gap-xs font-code-md text-code-md text-[11px] text-on-surface-variant uppercase tracking-wider">
                <span class="w-2 h-2 rounded-full bg-primary-container inline-block animate-pulse"></span>
                <span>Auth Gateway // v2.4</span>
              </div>
              <span class="font-code-md text-code-md text-[11px] text-on-surface-variant/80">SESSION ID: 902-TX</span>
            </div>
            
            <!-- Main Login Container Card -->
            <div class="bg-surface-container-lowest rounded-xl shadow-xl shadow-primary/5 p-md sm:p-xl flex flex-col transition-all">
              <!-- Brand Header Section -->
              <div class="flex flex-col items-center text-center mb-xl">
                <div class="w-12 h-12 rounded-xl bg-primary-fixed text-primary-container flex items-center justify-center mb-md shadow-sm">
                  <span class="material-symbols-outlined text-[26px]">receipt_long</span>
                </div>
                <h1 class="font-headline-md text-headline-md text-on-surface tracking-tight leading-none mb-xs">
                  Papertrail
                </h1>
                <p class="font-label-md text-label-md uppercase tracking-widest text-on-surface-variant">
                  Create. Send. Done.
                </p>
              </div>

              <!-- Form Elements -->
              <form class="flex flex-col gap-lg" id="auth-form" onsubmit="event.preventDefault();">
                <!-- Email Field -->
                <div class="flex flex-col gap-xs">
                  <div class="flex items-center justify-between">
                    <label class="font-label-md text-label-md text-on-surface-variant font-medium" for="email">
                      Business Email
                    </label>
                    <span class="font-code-md text-code-md text-[11px] text-primary-container font-medium">Verified</span>
                  </div>
                  <div class="relative flex items-center">
                    <span class="material-symbols-outlined absolute left-md text-on-surface-variant text-[18px] pointer-events-none">
                      alternate_email
                    </span>
                    <input class="w-full h-10 pl-10 pr-md bg-surface-container-low rounded-xl font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant/60 focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary-container/20 transition-all" id="email" placeholder="name@company.com" required="" type="email" value="louis@business.co"/>
                  </div>
                </div>

                <!-- Password Field -->
                <div class="flex flex-col gap-xs">
                  <div class="flex items-center justify-between">
                    <label class="font-label-md text-label-md text-on-surface-variant font-medium" for="password">
                      Password
                    </label>
                    <a class="font-label-md text-label-md text-primary-container hover:text-primary transition-colors" href="#">
                      Forgot password?
                    </a>
                  </div>
                  <div class="relative flex items-center">
                    <span class="material-symbols-outlined absolute left-md text-on-surface-variant text-[18px] pointer-events-none">
                      lock
                    </span>
                    <input class="w-full h-10 pl-10 pr-10 bg-surface-container-low rounded-xl font-body-md text-body-md text-on-surface placeholder:text-on-surface-variant/60 focus:bg-surface-container-lowest focus:outline-none focus:ring-2 focus:ring-primary-container/20 transition-all font-code-md tracking-wider" id="password" placeholder="Enter account password" required="" type="password" value="••••••••••••••••"/>
                    <button aria-label="Toggle password visibility" class="absolute right-xs p-xs text-on-surface-variant hover:text-on-surface flex items-center justify-center transition-colors rounded-lg" id="toggle-password" type="button">
                      <span class="material-symbols-outlined text-[18px]" id="toggle-icon">visibility</span>
                    </button>
                  </div>
                </div>

                <!-- Options Checkbox Row -->
                <div class="flex items-center justify-between pt-xs">
                  <label class="flex items-center gap-sm cursor-pointer select-none group">
                    <input checked="" class="w-4 h-4 rounded bg-surface-container-low accent-primary-container cursor-pointer transition" id="remember" type="checkbox"/>
                    <span class="font-body-md text-body-md text-[13px] text-on-surface-variant group-hover:text-on-surface transition-colors">
                      Remember me for 30 days
                    </span>
                  </label>
                  <span class="font-code-md text-code-md text-[11px] text-on-surface-variant bg-surface-container-high px-xs py-0.5 rounded">
                    TLS 1.3
                  </span>
                </div>

                <!-- Primary Submit Action -->
                <button class="w-full h-11 bg-primary-container hover:bg-primary text-on-primary font-title-md text-title-md text-[15px] font-medium rounded-xl flex items-center justify-center gap-xs shadow-md transition-all active:scale-[0.99] group mt-xs" id="submit-btn" type="submit">
                  <span id="btn-text">Sign In</span>
                  <span class="material-symbols-outlined text-[18px] group-hover:translate-x-0.5 transition-transform" id="btn-icon">
                    arrow_forward
                  </span>
                </button>
              </form>

              <!-- Trust Signals Layer -->
              <div class="mt-lg pt-md bg-surface-container-low -mx-md sm:-mx-xl -mb-md sm:-mb-xl p-md rounded-b-xl flex flex-wrap items-center justify-between gap-xs">
                <div class="flex items-center gap-xs text-on-surface-variant">
                  <span class="material-symbols-outlined text-[16px] text-primary-container">verified_user</span>
                  <span class="font-label-md text-label-md text-[11px]">256-bit SSL Banking Protocol</span>
                </div>
                <div class="flex items-center gap-xs text-on-surface-variant">
                  <span class="material-symbols-outlined text-[16px]">shield</span>
                  <span class="font-label-md text-label-md text-[11px]">SOC2 Type II</span>
                </div>
              </div>
            </div>

            <!-- Bottom Account Switcher -->
            <div class="text-center mt-lg">
              <p class="font-body-md text-body-md text-on-surface-variant">
                Don't have an account?
                <a class="font-title-md text-title-md text-[14px] text-primary-container hover:text-primary font-medium ml-xs transition-colors underline-offset-4 hover:underline" href="#">
                  Create an account free
                </a>
              </p>
            </div>

            <!-- Micro Audit Metadata -->
            <div class="flex justify-center items-center gap-md mt-md text-on-surface-variant/70 font-code-md text-code-md text-[11px] flex-wrap">
              <span>IP: 198.51.100.42</span>
              <span>•</span>
              <span>US-EAST RECEPTOR</span>
              <span>•</span>
              <span>STATUS: HEALTHY</span>
            </div>
          </div>
        </div>

        <!-- Interactive Logic script for micro-interactions -->
        <script>
          (function () {
            const toggleBtn = document.getElementById('toggle-password');
            const passInput = document.getElementById('password');
            const toggleIcon = document.getElementById('toggle-icon');

            if (toggleBtn && passInput && toggleIcon) {
              toggleBtn.addEventListener('click', function () {
                const isPassword = passInput.type === 'password';
                passInput.type = isPassword ? 'text' : 'password';
                toggleIcon.textContent = isPassword ? 'visibility_off' : 'visibility';
              });
            }

            const form = document.getElementById('auth-form');
            const btn = document.getElementById('submit-btn');
            const btnText = document.getElementById('btn-text');
            const btnIcon = document.getElementById('btn-icon');

            if (form && btn) {
              form.addEventListener('submit', function (e) {
                e.preventDefault();
                btn.disabled = true;
                btnText.textContent = 'Verifying Credential...';
                btnIcon.textContent = 'sync';
                btnIcon.classList.add('animate-spin');

                setTimeout(function () {
                  btn.disabled = false;
                  btnText.textContent = 'Success';
                  btnIcon.textContent = 'check';
                  btnIcon.classList.remove('animate-spin');
                  
                  setTimeout(function() {
                    btnText.textContent = 'Sign In';
                    btnIcon.textContent = 'arrow_forward';
                  }, 1800);
                }, 1000);
              });
            }
          })();
        </script>
      </div>
    </main>
  </div>
</body>
</html>