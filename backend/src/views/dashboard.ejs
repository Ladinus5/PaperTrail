<main class="w-full bg-surface">
  <div class="w-full p-md sm:p-lg lg:p-xl">
    <div class="max-w-7xl mx-auto">

      <!-- Header -->
      <div class="mb-xl">
        <h1 class="text-headline-lg font-headline-lg text-on-surface mb-1">
          <%= greeting %>, <%= user.name %>
        </h1>
        <p class="text-body-md text-on-surface-variant">Here's what's happening with your receipts today.</p>
      </div>

      <!-- Summary Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-lg mb-xl">

        <div class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-lg relative overflow-hidden group hover:shadow-md transition-shadow duration-300">
          <div class="absolute top-0 right-0 p-md opacity-10 group-hover:opacity-20 transition-opacity">
            <span class="material-symbols-outlined text-[80px] text-primary">payments</span>
          </div>
          <div class="text-label-md font-label-md text-secondary uppercase tracking-wider mb-sm">Total Sales</div>
          <div class="text-headline-lg font-bold text-on-surface mb-md"><%= formatCurrency(stats.totalSales) %></div>
          <div class="inline-flex items-center gap-1 bg-[#dcfce7] text-[#15803d] px-2 py-1 rounded text-label-md font-medium">
            <span class="material-symbols-outlined text-[14px]">arrow_upward</span>
            All time
          </div>
        </div>

        <div class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-lg relative overflow-hidden group hover:shadow-md transition-shadow duration-300">
          <div class="absolute top-0 right-0 p-md opacity-10 group-hover:opacity-20 transition-opacity">
            <span class="material-symbols-outlined text-[80px] text-primary">receipt_long</span>
          </div>
          <div class="text-label-md font-label-md text-secondary uppercase tracking-wider mb-sm">Receipts</div>
          <div class="text-headline-lg font-bold text-on-surface mb-md"><%= stats.receiptCount %></div>
          <div class="inline-flex items-center gap-1 bg-[#dcfce7] text-[#15803d] px-2 py-1 rounded text-label-md font-medium">
            <span class="material-symbols-outlined text-[14px]">arrow_upward</span>
            All time
          </div>
        </div>

        <div class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl p-lg relative overflow-hidden group hover:shadow-md transition-shadow duration-300 sm:col-span-2 lg:col-span-1">
          <div class="absolute top-0 right-0 p-md opacity-10 group-hover:opacity-20 transition-opacity">
            <span class="material-symbols-outlined text-[80px] text-primary">group</span>
          </div>
          <div class="text-label-md font-label-md text-secondary uppercase tracking-wider mb-sm">Customers</div>
          <div class="text-headline-lg font-bold text-on-surface mb-md"><%= stats.customerCount %></div>
          <div class="inline-flex items-center gap-1 bg-[#dcfce7] text-[#15803d] px-2 py-1 rounded text-label-md font-medium">
            <span class="material-symbols-outlined text-[14px]">arrow_upward</span>
            All time
          </div>
        </div>
      </div>

      <!-- Recent Receipts -->
      <div class="bg-surface-container-lowest border border-outline-variant/30 rounded-xl overflow-hidden shadow-sm">
        <div class="px-lg py-md border-b border-outline-variant/30 flex justify-between items-center bg-surface">
          <h2 class="text-title-md font-title-md text-on-surface">Recent Receipts</h2>
          <a href="/receipts" class="text-primary text-label-md font-semibold hover:underline">View All</a>
        </div>

        <% if (recentReceipts.length === 0) { %>
          <div class="p-xl text-center">
            <span class="material-symbols-outlined text-[48px] text-on-surface-variant/40 mb-sm block">receipt_long</span>
            <p class="text-body-md text-on-surface-variant mb-md">No receipts yet.</p>
            <a href="/receipts/new" class="inline-flex items-center gap-1 bg-primary-container hover:bg-primary text-on-primary px-md py-sm rounded-lg text-label-md font-semibold transition-colors">
              <span class="material-symbols-outlined text-[16px]">add</span>
              Create your first receipt
            </a>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead>
                <tr class="bg-surface border-b border-outline-variant/30">
                  <th class="py-sm px-lg text-label-md text-secondary uppercase tracking-wider font-semibold">Receipt #</th>
                  <th class="py-sm px-lg text-label-md text-secondary uppercase tracking-wider font-semibold">Customer</th>
                  <th class="py-sm px-lg text-label-md text-secondary uppercase tracking-wider font-semibold">Amount</th>
                  <th class="py-sm px-lg text-label-md text-secondary uppercase tracking-wider font-semibold">Status</th>
                  <th class="py-sm px-lg text-label-md text-secondary uppercase tracking-wider font-semibold">Date</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-outline-variant/20">
                <% recentReceipts.forEach(r => { %>
                  <tr class="hover:bg-surface-container-low transition-colors cursor-pointer">
                    <td class="py-3 px-lg font-code-md text-body-md text-on-surface"><%= r.receiptNumber %></td>
                    <td class="py-3 px-lg text-body-md text-on-surface font-medium"><%= r.customer?.name || "—" %></td>
                    <td class="py-3 px-lg text-body-md text-on-surface"><%= formatCurrency(r.total) %></td>
                    <td class="py-3 px-lg">
                      <% if (r.paymentStatus === "PAID") { %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-[#dcfce7] text-[#15803d] text-label-md font-semibold">Paid</span>
                      <% } else if (r.status === "PENDING") { %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-secondary-container text-on-secondary-container text-label-md font-semibold">Pending</span>
                      <% } else { %>
                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-surface-container text-on-surface-variant text-label-md font-semibold"><%= r.status %></span>
                      <% } %>
                    </td>
                    <td class="py-3 px-lg text-body-md text-on-surface-variant"><%= timeAgo(r.createdAt) %></td>
                  </tr>
                <% }) %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>

    </div>
  </div>
</main>