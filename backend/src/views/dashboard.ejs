                    </button>
                    <button class="p-2 text-[#00357f] hover:bg-slate-100 rounded-full transition-colors focus:outline-none focus:ring-2 focus:ring-[#004aad]">
                        <span class="material-symbols-outlined">help_outline</span>
                    </button>
                </div>
                <img class="hidden md:block w-8 h-8 rounded-full object-cover border border-slate-200 cursor-pointer hover:ring-2 hover:ring-[#004aad] transition-all" alt="Louis" src="https://lh3.googleusercontent.com/aida-public/AB6AXuASGXSb_k0bDCOJ1ghqw6qqDaF5WDmY4XPcX2hl0Rcxj39IX28vobM1I0LfbG-jVEmmRVKSmoR_-lpfERkkRKMaZxCZWCFqXHRolxhCcSdRT0nDnkTgtFdSD5YYEEmezKQcwD9fop-G-5iv056epAwDxn2_5IOy7tQCzaUCEG-CkIcvwowyYBunDzx9ThJ2KZJkNYVMaQj-CWitbvQgZ8kQkq4xs-Wda1eGEKdaDRKQYHCc0SLSAg"/>
            </div>
        </header>

        <!-- Canvas -->
        <main class="flex-1 overflow-y-auto p-4 sm:p-6 lg:p-10 bg-[#faf8ff]">
            <div class="max-w-7xl mx-auto">
                
                <!-- Header Section -->
                <div class="mb-8">
                    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-semibold text-[#191b22] mb-1">Good afternoon, Louis 👋</h1>
                    <p class="text-sm sm:text-base text-slate-600">Here's what's happening with your receipts today.</p>
                </div>

                <!-- Summary Cards (Bento style grid) -->
                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 mb-8">
                    <div class="bg-white border border-slate-200 rounded-xl p-6 relative overflow-hidden group hover:shadow-md transition-shadow duration-300">
                        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                            <span class="material-symbols-outlined text-[80px] text-[#00357f]">payments</span>
                        </div>
                        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Total Sales</div>
                        <div class="text-3xl sm:text-4xl font-bold text-[#191b22] mb-3">₦245,000</div>
                        <div class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 px-2 py-1 rounded text-xs font-medium">
                            <span class="material-symbols-outlined text-[14px]">trending_up</span>
                            +12% this month
                        </div>
                    </div>

                    <div class="bg-white border border-slate-200 rounded-xl p-6 relative overflow-hidden group hover:shadow-md transition-shadow duration-300">
                        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                            <span class="material-symbols-outlined text-[80px] text-[#00357f]">receipt_long</span>
                        </div>
                        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Receipts</div>
                        <div class="text-3xl sm:text-4xl font-bold text-[#191b22] mb-3">42</div>
                        <div class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 px-2 py-1 rounded text-xs font-medium">
                            <span class="material-symbols-outlined text-[14px]">arrow_upward</span>
                            +8 this month
                        </div>
                    </div>

                    <div class="bg-white border border-slate-200 rounded-xl p-6 relative overflow-hidden group hover:shadow-md transition-shadow duration-300 sm:col-span-2 lg:col-span-1">
                        <div class="absolute top-0 right-0 p-4 opacity-10 group-hover:opacity-20 transition-opacity">
                            <span class="material-symbols-outlined text-[80px] text-[#00357f]">group</span>
                        </div>
                        <div class="text-xs font-semibold text-slate-500 uppercase tracking-wider mb-2">Customers</div>
                        <div class="text-3xl sm:text-4xl font-bold text-[#191b22] mb-3">28</div>
                        <div class="inline-flex items-center gap-1 bg-emerald-50 text-emerald-700 px-2 py-1 rounded text-xs font-medium">
                            <span class="material-symbols-outlined text-[14px]">arrow_upward</span>
                            +4 this month
                        </div>
                    </div>
                </div>

                <!-- Recent Receipts Table Section -->
                <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-sm">
                    <div class="px-6 py-4 border-b border-slate-200 flex justify-between items-center bg-[#faf8ff]">
                        <h2 class="text-lg font-semibold text-[#191b22]">Recent Receipts</h2>
                        <button class="text-[#004aad] text-xs font-semibold hover:underline">View All</button>
                    </div>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left border-collapse">
                            <thead>
                                <tr class="bg-[#faf8ff] border-b border-slate-200">
                                    <th class="py-3 px-6 text-xs text-slate-500 uppercase tracking-wider font-semibold">Receipt #</th>
                                    <th class="py-3 px-6 text-xs text-slate-500 uppercase tracking-wider font-semibold">Customer</th>
                                    <th class="py-3 px-6 text-xs text-slate-500 uppercase tracking-wider font-semibold">Amount</th>
                                    <th class="py-3 px-6 text-xs text-slate-500 uppercase tracking-wider font-semibold">Status</th>
                                    <th class="py-3 px-6 text-xs text-slate-500 uppercase tracking-wider font-semibold">Date</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100">
                                <tr class="hover:bg-slate-50 transition-colors cursor-pointer">
                                    <td class="py-3.5 px-6 font-mono text-sm text-[#191b22]">REC-000042</td>
                                    <td class="py-3.5 px-6 text-sm text-[#191b22] font-medium">John Doe</td>
                                    <td class="py-3.5 px-6 text-sm text-[#191b22]">₦25,000</td>
                                    <td class="py-3.5 px-6">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">Paid</span>
                                    </td>
                                    <td class="py-3.5 px-6 text-sm text-slate-500">Today</td>
                                </tr>
                                <tr class="hover:bg-slate-50 transition-colors cursor-pointer">
                                    <td class="py-3.5 px-6 font-mono text-sm text-[#191b22]">REC-000041</td>
                                    <td class="py-3.5 px-6 text-sm text-[#191b22] font-medium">Mary Jane</td>
                                    <td class="py-3.5 px-6 text-sm text-[#191b22]">₦12,500</td>
                                    <td class="py-3.5 px-6">
                                        <span class="inline-flex items-center px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 text-xs font-semibold">Paid</span>
                                    </td>
                                    <td class="py-3.5 px-6 text-sm text-slate-500">Today</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

            </div>
        </main>
    </div>

    <!-- Mobile Drawer Script -->
    <script>
        const openBtn = document.getElementById('open-drawer-btn');
        const closeBtn = document.getElementById('close-drawer-btn');
        const drawer = document.getElementById('mobile-nav-drawer');
        const overlay = document.getElementById('mobile-nav-overlay');

        function toggleDrawer() {
            const isClosed = drawer.classList.contains('-translate-x-full');
            if (isClosed) {
                drawer.classList.remove('-translate-x-full');
                overlay.classList.remove('hidden');
            } else {
                drawer.classList.add('-translate-x-full');
                overlay.classList.add('hidden');
            }
        }

        openBtn.addEventListener('click', toggleDrawer);
        closeBtn.addEventListener('click', toggleDrawer);
        overlay.addEventListener('click', toggleDrawer);
    </script>
</body>
</html>