    <!-- Mobile Nav Overlay -->
    <div class="fixed inset-0 bg-black/40 backdrop-blur-sm z-40 hidden md:hidden transition-opacity" id="mobile-nav-overlay"></div>

    <!-- Main Content Area -->
    <div class="flex-1 flex flex-col md:ml-64 w-full min-w-0">
        
        <!-- TopAppBar -->
        <header class="bg-[#faf8ff] sticky top-0 z-30 border-b border-slate-200 shadow-sm flex justify-between items-center w-full px-4 sm:px-6 lg:px-10 h-16">
            <div class="flex items-center gap-4">
                <button class="md:hidden text-slate-600 p-1.5 hover:bg-slate-100 rounded-lg" id="open-drawer-btn">
                    <span class="material-symbols-outlined">menu</span>
                </button>
                <span class="md:hidden text-xl font-black text-[#00357f]">Papertrail</span>
                
                <div class="hidden md:flex relative w-64">
                    <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-[20px]">search</span>
                    <input class="w-full h-10 pl-10 pr-3 bg-white border border-slate-200 rounded-lg text-sm text-[#191b22] placeholder:text-slate-400 focus:ring-2 focus:ring-[#004aad] focus:border-[#004aad] transition-all shadow-sm" placeholder="Search..." type="text"/>
                </div>
            </div>

            <div class="flex items-center gap-3 sm:gap-4">
                <button class="hidden md:flex bg-[#004aad] text-white text-xs font-semibold rounded-lg py-2 px-4 hover:bg-[#00357f] transition-colors items-center gap-1 shadow-sm">
                    + Create Receipt
