        <div class="flex flex-col p-4 gap-2 h-full">
            <div class="flex justify-between items-center mb-6">
                <span class="text-2xl font-bold text-[#00357f]">Papertrail</span>
                <button class="text-slate-600 p-2 hover:bg-slate-100 rounded-lg" id="close-drawer-btn">
                    <span class="material-symbols-outlined">close</span>
                </button>
            </div>
            <div class="flex items-center gap-3 mb-6 p-2 bg-slate-100 rounded-lg">
                <img class="w-10 h-10 rounded-full object-cover border border-slate-200" alt="Louis" src="https://lh3.googleusercontent.com/aida-public/AB6AXuDfNhurURwR6iSAoy-ImqeAs33WdvtLm3g_fvqUkJ3Ch8fLSuEsg4FjHx6Cv2TJ1xWcuZWZV8XfXL6C-xCQvlJzDQovjiujkOgLYn-R-d5mU9fMvuB44ApGIXOQuJZfDm-q2Jk2ckYPZrWzly3aNY0mnUG5ums3tiFoenHvG0LynfnaLx7sQ9THxDFRSaT68ac21fThwTsTYc_-PySCJQJsjxVmNd4GX5qFBjdtjuXEtO4oVzVNrA"/>
                <div>
                    <div class="text-sm font-semibold text-[#191b22]">Louis</div>
                </div>
            </div>
            <ul class="flex flex-col gap-1 flex-1">
                <li>
                    <a class="flex items-center gap-3 px-4 py-2.5 rounded-xl bg-[#004aad] text-white font-medium text-sm transition-colors" href="#">
                        <span class="material-symbols-outlined fill">dashboard</span>
                        <span>Dashboard</span>
                    </a>
                </li>
                <li>
                    <a class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-slate-700 font-medium text-sm hover:bg-slate-100 transition-colors" href="#">
                        <span class="material-symbols-outlined">receipt_long</span>
                        <span>Receipts</span>
                    </a>
                </li>
                <li>
                    <a class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-slate-700 font-medium text-sm hover:bg-slate-100 transition-colors" href="#">
                        <span class="material-symbols-outlined">group</span>
                        <span>Customers</span>
                    </a>
                </li>
                <li>
                    <a class="flex items-center gap-3 px-4 py-2.5 rounded-xl text-slate-700 font-medium text-sm hover:bg-slate-100 transition-colors" href="#">
                        <span class="material-symbols-outlined">description</span>
