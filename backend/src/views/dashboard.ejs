            <ul class="flex flex-col gap-2 flex-1">
                <li>
                    <a class="flex items-center gap-2 px-3 py-2 rounded-lg text-[#00357f] font-bold border-r-4 border-[#00357f] bg-slate-100 transition-colors" href="#">
                        <span class="material-symbols-outlined fill text-[20px]">dashboard</span>
                        <span class="text-sm">Dashboard</span>
                    </a>
                </li>
                <li>
                    <a class="flex items-center gap-2 px-3 py-2 rounded-lg text-slate-600 hover:text-[#00357f] hover:bg-slate-100 transition-colors" href="#">
                        <span class="material-symbols-outlined text-[20px]">receipt_long</span>
                        <span class="text-sm">Receipts</span>
                    </a>
                </li>
                <li>
                    <a class="flex items-center gap-2 px-3 py-2 rounded-lg text-slate-600 hover:text-[#00357f] hover:bg-slate-100 transition-colors" href="#">
                        <span class="material-symbols-outlined text-[20px]">group</span>
                        <span class="text-sm">Customers</span>
                    </a>
                </li>
                <li>
                    <a class="flex items-center gap-2 px-3 py-2 rounded-lg text-slate-600 hover:text-[#00357f] hover:bg-slate-100 transition-colors" href="#">
                        <span class="material-symbols-outlined text-[20px]">description</span>
