<main class="w-full pt-16 bg-surface px-md sm:px-lg py-md sm:py-xl min-h-screen pb-40">
  <div class="max-w-[1400px] w-full mx-auto">

    <!-- Header -->
    <div class="mb-lg">
      <h1 class="font-headline-lg text-headline-lg text-on-surface tracking-tight">Create Receipt</h1>
      <p class="font-body-md text-body-md text-on-surface-variant mt-1">Configure information and style in real-time.</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-lg">

      <!-- Left: Editor -->
      <div class="lg:col-span-7 bg-surface-container-lowest rounded-xl border border-outline-variant/40 p-lg shadow-sm space-y-8">

        <form id="receiptForm" class="space-y-8">

          <div id="receiptError"
               class="hidden p-md rounded-lg bg-error-container text-on-error-container font-body-md text-body-md border border-error/30"></div>

          <!-- Customer -->
          <div>
            <label class="text-label-md font-label-md uppercase tracking-wider text-on-surface-variant block mb-sm" for="customerId">Customer</label>
            <div class="relative">
              <select id="customerId" name="customerId"
                class="w-full h-10 px-sm bg-surface-container-low border border-outline-variant/50 rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-container/20 appearance-none pr-10 cursor-pointer">
                <option value="">Walk-in / No customer</option>
                <% customers.forEach(c => { %>
                  <option value="<%= c.id %>" <%= c.id === preselectedCustomerId ? 'selected' : '' %>><%= c.name %></option>
                <% }) %>
              </select>
              <span class="material-symbols-outlined absolute right-3 top-2.5 text-on-surface-variant pointer-events-none">expand_more</span>
            </div>
          </div>

          <!-- Items -->
          <div>
            <label class="text-label-md font-label-md uppercase tracking-wider text-on-surface-variant block mb-sm">Itemized List</label>

            <div class="hidden sm:grid sm:grid-cols-12 gap-3 mb-sm px-1 text-label-md font-label-md text-on-surface-variant">
              <div class="col-span-6">Description</div>
              <div class="col-span-2 text-right">Qty</div>
              <div class="col-span-3 text-right">Unit Price</div>
              <div class="col-span-1"></div>
            </div>

            <div id="itemsList" class="space-y-3"></div>

            <button type="button" id="addItemBtn"
              class="w-full mt-sm h-10 border-2 border-dashed border-primary-fixed-dim hover:border-primary-container hover:bg-primary-fixed/30 text-primary-container rounded-xl font-medium text-body-md flex items-center justify-center transition-all">
              <span class="material-symbols-outlined text-[18px] mr-1">add</span> Add Another Item
            </button>
          </div>

          <hr class="border-outline-variant/30"/>

          <!-- Payment method -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-md">
            <div>
              <label class="text-label-md font-label-md uppercase tracking-wider text-on-surface-variant block mb-sm" for="paymentMethod">Payment Method</label>
              <div class="relative">
                <select id="paymentMethod" name="paymentMethod"
                  class="w-full h-10 px-sm bg-surface-container-low border border-outline-variant/50 rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-container/20 appearance-none pr-10 cursor-pointer">
                  <option value="Bank Transfer">Bank Transfer</option>
                  <option value="Cash">Cash</option>
                  <option value="Credit Card">Credit Card</option>
                  <option value="Cheque">Cheque</option>
                </select>
                <span class="material-symbols-outlined absolute right-3 top-2.5 text-on-surface-variant pointer-events-none">expand_more</span>
              </div>
            </div>

            <div>
              <label class="text-label-md font-label-md uppercase tracking-wider text-on-surface-variant block mb-sm" for="paymentStatus">Payment Status</label>
              <div class="relative">
                <select id="paymentStatus" name="paymentStatus"
                  class="w-full h-10 px-sm bg-surface-container-low border border-outline-variant/50 rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-container/20 appearance-none pr-10 cursor-pointer">
                  <option value="PAID" selected>Paid</option>
                  <option value="PENDING">Pending</option>
                  <option value="CANCELLED">Cancelled</option>
                </select>
                <span class="material-symbols-outlined absolute right-3 top-2.5 text-on-surface-variant pointer-events-none">expand_more</span>
              </div>
            </div>
          </div>

          <!-- Notes -->
          <div>
            <label class="text-label-md font-label-md uppercase tracking-wider text-on-surface-variant block mb-sm" for="notes">Notes (optional)</label>
            <textarea id="notes" name="notes" rows="2"
              class="w-full p-sm bg-surface-container-low border border-outline-variant/50 rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-container/20 transition-all resize-none"
              placeholder="Any extra information..."></textarea>
          </div>

        </form>
      </div>

      <!-- Right: Live Preview -->
      <div class="lg:col-span-5 bg-surface-container-lowest rounded-xl border border-outline-variant/40 shadow-sm p-lg h-fit">
        <div class="flex items-center gap-sm mb-lg">
          <span class="material-symbols-outlined text-primary text-[20px]">visibility</span>
          <div class="flex flex-col">
            <span class="font-title-md text-title-md text-[14px] font-semibold text-on-surface">Live Preview</span>
            <span class="font-label-md text-label-md text-on-surface-variant text-[11px]">Reflects changes instantly</span>
          </div>
        </div>

        <div class="bg-surface-container-low rounded-xl p-md">
          <div class="bg-surface-container-lowest rounded-lg shadow-md p-lg flex flex-col gap-md text-body-md">
            <div class="h-1.5 bg-primary-container rounded-full -mt-lg -mx-lg mb-md"></div>

            <div class="flex justify-between items-start">
              <div class="flex flex-col">
                <span class="font-headline-md text-headline-md text-[15px] font-bold text-primary-container tracking-tight uppercase"><%= company.name %></span>
                <% if (company.email) { %><span class="font-label-md text-[10px] text-secondary"><%= company.email %></span><% } %>
                <% if (company.phone) { %><span class="font-label-md text-[10px] text-secondary"><%= company.phone %></span><% } %>
              </div>
              <div class="flex flex-col items-end">
                <span class="font-code-md text-code-md text-[11px] font-semibold text-on-surface" id="previewNumber"><%= nextNumber %></span>
                <span class="font-label-md text-label-md text-[10px] text-secondary" id="previewDate"><%= new Date().toLocaleDateString() %></span>
                <span id="previewStatus" class="mt-xs inline-block px-1.5 py-0.5 rounded text-[9px] font-bold uppercase bg-[#dcfce7] text-[#15803d] tracking-wider">PAID</span>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-md">
              <div class="flex flex-col">
                <span class="text-[10px] uppercase font-semibold text-secondary">Billed To</span>
                <span class="text-body-md font-medium text-on-surface" id="previewCustomer">Walk-in Customer</span>
              </div>
            </div>

            <div class="border-y border-outline-variant/40 py-sm">
              <table class="w-full text-left border-collapse">
                <thead>
                  <tr class="text-[10px] uppercase font-semibold text-secondary">
                    <th class="pb-1">Description</th>
                    <th class="pb-1 text-center">Qty</th>
                    <th class="pb-1 text-right">Amount</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-outline-variant/20" id="previewItems"></tbody>
              </table>
            </div>

            <div class="flex flex-col gap-1 pt-1">
              <div class="flex justify-between text-[11px] text-secondary">
                <span>Subtotal</span>
                <span class="font-code-md" id="previewSubtotal">₦0.00</span>
              </div>
              <div class="flex justify-between text-[11px] text-secondary">
                <span>Tax</span>
                <span class="font-code-md" id="previewTax">₦0.00</span>
              </div>
              <div class="flex justify-between text-[13px] font-bold text-on-surface pt-2 border-t border-on-surface">
                <span>Total</span>
                <span class="text-primary-container font-code-md" id="previewTotal">₦0.00</span>
              </div>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>

  <!-- Sticky Footer -->
  <div class="fixed bottom-0 left-0 lg:left-64 right-0 bg-surface-container-lowest border-t border-outline-variant/30 p-md flex items-center justify-between z-30 shadow-lg">
    <div class="flex items-center gap-md">
      <div>
        <span class="text-label-md font-bold uppercase tracking-wider text-on-surface-variant block">Total Amount</span>
        <span class="text-headline-md font-bold text-on-surface" id="footerTotal">₦0</span>
      </div>
    </div>
    <div class="flex items-center gap-md">
      <a href="/receipts" class="hidden sm:flex h-10 px-lg items-center justify-center border border-outline-variant/50 rounded-xl text-on-surface font-semibold text-body-md hover:bg-surface-container-low transition-colors">
        Cancel
      </a>
      <button type="submit" form="receiptForm" id="submitReceiptBtn"
        class="h-10 px-lg sm:px-xl bg-primary-container hover:bg-primary text-on-primary rounded-xl font-semibold text-body-md shadow-sm transition-colors flex items-center justify-center gap-2 disabled:opacity-60">
        <span class="material-symbols-outlined text-[18px]">check</span>
        <span id="submitBtnText">Create Receipt</span>
      </button>
    </div>
  </div>
</main>

<script>
  const CURRENCY = '<%= company.currency || "NGN" %>';
  const SYMBOLS = { NGN: '₦', USD: '$', GBP: '£', GHS: '₵' };
  const SYM = SYMBOLS[CURRENCY] || '₦';
  const itemsList = document.getElementById('itemsList');
  const previewItems = document.getElementById('previewItems');

  function fmt(n) {
    return SYM + Number(n || 0).toLocaleString('en-NG', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
  }

  function makeRow() {
    const row = document.createElement('div');
    row.className = 'receipt-item flex flex-col sm:grid sm:grid-cols-12 gap-3 p-3 sm:p-0 border border-outline-variant/50 sm:border-none rounded-xl sm:rounded-none bg-surface-container-low sm:bg-transparent';
    row.innerHTML = `
      <div class="col-span-6">
        <label class="sm:hidden text-label-md font-label-md text-on-surface-variant mb-1 block">Description</label>
        <input type="text" data-field="name" placeholder="Item name"
          class="item-name w-full h-10 px-sm bg-surface-container-lowest border border-outline-variant/50 rounded-lg text-body-md text-on-surface focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-container/20"/>
      </div>
      <div class="col-span-2">
        <label class="sm:hidden text-label-md font-label-md text-on-surface-variant mb-1 block">Qty</label>
        <input type="number" min="1" value="1" data-field="quantity"
          class="item-qty w-full h-10 px-sm bg-surface-container-lowest border border-outline-variant/50 rounded-lg text-body-md text-on-surface sm:text-right focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-container/20"/>
      </div>
      <div class="col-span-3">
        <label class="sm:hidden text-label-md font-label-md text-on-surface-variant mb-1 block">Price</label>
        <input type="number" min="0" step="0.01" value="0" data-field="unitPrice"
          class="item-price w-full h-10 px-sm bg-surface-container-lowest border border-outline-variant/50 rounded-lg text-body-md text-on-surface text-right focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary-container/20"/>
      </div>
      <div class="col-span-1 flex items-center justify-end">
        <button type="button" class="item-remove p-sm text-error hover:bg-error-container rounded-lg transition-colors">
          <span class="material-symbols-outlined text-[20px]">delete</span>
        </button>
      </div>
    `;
    row.querySelector('.item-remove').addEventListener('click', () => {
      row.remove();
      updatePreview();
    });
    row.querySelectorAll('input').forEach(inp => inp.addEventListener('input', updatePreview));
    itemsList.appendChild(row);
    updatePreview();
  }

  function getItems() {
    return [...document.querySelectorAll('.receipt-item')].map(row => {
      const name = row.querySelector('.item-name').value.trim();
      const quantity = Number(row.querySelector('.item-qty').value) || 0;
      const unitPrice = Number(row.querySelector('.item-price').value) || 0;
      return { name, quantity, unitPrice, total: quantity * unitPrice };
    }).filter(i => i.name && i.quantity > 0);
  }

  function updatePreview() {
    const items = getItems();
    const subtotal = items.reduce((s, i) => s + i.total, 0);
    const tax = 0;
    const total = subtotal + tax;

    previewItems.innerHTML = items.length
      ? items.map(i => `
          <tr>
            <td class="py-1 text-body-md text-on-surface">${i.name}</td>
            <td class="py-1 text-center text-secondary">${i.quantity}</td>
            <td class="py-1 text-right font-code-md text-on-surface">${fmt(i.total)}</td>
          </tr>`).join('')
      : '<tr><td colspan="3" class="py-2 text-center text-secondary text-[11px]">No items</td></tr>';

    document.getElementById('previewSubtotal').textContent = fmt(subtotal);
    document.getElementById('previewTax').textContent = fmt(tax);
    document.getElementById('previewTotal').textContent = fmt(total);
    document.getElementById('footerTotal').textContent = SYM + Number(total).toLocaleString('en-NG', { minimumFractionDigits: 0, maximumFractionDigits: 2 });
  }

  document.getElementById('customerId').addEventListener('change', (e) => {
    const sel = e.target.selectedOptions[0];
    document.getElementById('previewCustomer').textContent = sel && sel.value ? sel.textContent : 'Walk-in Customer';
  });

  document.getElementById('paymentStatus').addEventListener('change', (e) => {
    const el = document.getElementById('previewStatus');
    const v = e.target.value;
    el.textContent = v;
    el.className = 'mt-xs inline-block px-1.5 py-0.5 rounded text-[9px] font-bold uppercase tracking-wider ' +
      (v === 'PAID' ? 'bg-[#dcfce7] text-[#15803d]' : v === 'PENDING' ? 'bg-secondary-container text-on-secondary-container' : 'bg-surface-container text-on-surface-variant');
  });

  document.getElementById('addItemBtn').addEventListener('click', makeRow);

  makeRow();

  document.getElementById('receiptForm').addEventListener('submit', async (e) => {
    e.preventDefault();
    const errorBox = document.getElementById('receiptError');
    const btn = document.getElementById('submitReceiptBtn');
    const btnText = document.getElementById('submitBtnText');

    errorBox.classList.add('hidden');

    const items = getItems();
    if (items.length === 0) {
      errorBox.textContent = 'Add at least one item with a name and quantity.';
      errorBox.classList.remove('hidden');
      return;
    }

    btn.disabled = true;
    btnText.textContent = 'Creating...';

    const payload = {
      customerId: document.getElementById('customerId').value || null,
      paymentMethod: document.getElementById('paymentMethod').value,
      paymentStatus: document.getElementById('paymentStatus').value,
      notes: document.getElementById('notes').value.trim() || null,
      items,
    };

    try {
      const res = await fetch('/api/receipts', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        credentials: 'include',
        body: JSON.stringify(payload),
      });

      const raw = await res.text();
      let data;
      try { data = JSON.parse(raw); } catch { throw new Error('Server error — please try again.'); }

      if (!res.ok || !data.success) throw new Error(data.message || 'Failed to create receipt');

      // ⭐ Redirect to the receipt detail page so the user can download / share
      const newReceiptId = data.data?.receipt?.id || data.data?.id;
      if (newReceiptId) {
        window.location.href = '/receipts/' + newReceiptId;
      } else {
        window.location.href = '/receipts';
      }
    } catch (err) {
      errorBox.textContent = err.message;
      errorBox.classList.remove('hidden');
      btn.disabled = false;
      btnText.textContent = 'Create Receipt';
    }
  });
</script>